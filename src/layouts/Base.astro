---
import '../styles/global.css'
import { FLAGS, SITE } from '../config/site.ts'
import { pageIndexable, serializeJsonLd } from '../lib/seo.ts'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Analytics from '../components/Analytics.astro'
import { getSite } from '../lib/store.ts'

interface Props {
    title: string
    description: string
    /** Canonical path, e.g. "/foretag/0020001012/exempel-ab/". */
    path: string
    /** Page-level noindex (thin, synthetic or restricted content). */
    noindex?: boolean
    jsonLd?: object[]
}

const { title, description, path, noindex = false, jsonLd = [] } = Astro.props
// A synthetic dataset is never indexable, whatever the flags say.
const robots = pageIndexable(noindex, getSite().synthetic) ? 'index,follow' : 'noindex,follow'
const canonical = SITE.origin + path
const fullTitle = path === '/' ? `${SITE.name} – ${title}` : `${title} | ${SITE.name}`
---

<!doctype html>
<html lang="sv">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <script is:inline>document.documentElement.classList.add('js')</script>
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta name="robots" content={robots} />
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="sv_SE" />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta name="theme-color" content="#050a15" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        {jsonLd.map((d) => <script type="application/ld+json" set:html={serializeJsonLd(d)} />)}
    </head>
    <body>
        <a class="skip" href="#main">Hoppa till innehållet</a>
        {
            FLAGS.preview && (
                <div class="env-banner">
                    Förhandsversion – inte publicerad, inte indexerad. Dataset: <code>{process.env.SE_DATA_SOURCE ?? 'CURRENT'}</code>
                </div>
            )
        }
        <Nav current={path} />
        <main id="main">
            <slot />
        </main>
        <Footer />
        <Analytics />
        <script>
            import '../scripts/motion.ts'
        </script>
    </body>
</html>

<style>
    .env-banner {
        position: relative;
        z-index: 40;
        background: var(--night);
        color: var(--ice-2);
        font-size: 0.78rem;
        padding: 7px var(--gutter);
        text-align: center;
        border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }
    .env-banner code {
        font-family: var(--mono);
    }
</style>
