---
import '../styles/global.css'
import { FLAGS, SITE } from '../config/site.ts'
import { isIndexable } from '../lib/seo.ts'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Analytics from '../components/Analytics.astro'
import { getSite } from '../lib/store.ts'

interface Props {
    title: string
    description: string
    /** Canonical path, e.g. "/foretag/0020001012/exempel-ab/". */
    path: string
    /** Page-level noindex (thin, synthetic or restricted content). */
    noindex?: boolean
    jsonLd?: object[]
}

const { title, description, path, noindex = false, jsonLd = [] } = Astro.props
// A synthetic dataset is never indexable, whatever the flags say.
const robots = isIndexable(noindex, getSite().synthetic) ? 'index,follow' : 'noindex,follow'
const canonical = SITE.origin + path
const fullTitle = path === '/' ? `${SITE.name} – ${title}` : `${title} | ${SITE.name}`
---

<!doctype html>
<html lang="sv">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <script is:inline>document.documentElement.classList.add('js')</script>
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta name="robots" content={robots} />
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="sv_SE" />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta name="theme-color" content="#050a15" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    </head>
    <body>
        <Fragment set:html={`<!--
THESIS: Blå timmen. Swedish company facts shown the way a premium fintech shows money: night-navy chrome over Stockholm at blue hour, product panels in glass, every number still sourced, dated and honest about gaps. Refuses the flat grey directory table and the generic purple SaaS gradient.
OWN-WORLD: night #050a15, ice text #eef3fa, glow blue #7fb2ff for data, city-light gold #f4bf72 for emphasis and gaps; day surfaces #f3f5f9 with white 20px cards; Source Serif 4 light display, Geist UI, Geist Mono numerals; glass panels, grain, photography.
STORY: the visitor sees the city, types a company, watches real-looking figures assemble, understands what is missing and what is not launched yet.
FIRST VIEWPORT: full-bleed Stockholm blue-hour photo; left, a light serif headline and a glass search with a typing placeholder; right, a floating glass profile card whose numbers count up while a gold line traces the skyline.
FORM: user-pinned redesign, no roll: "luxurious, modern, financial saas ... add animations, cool graphics", inspiration 21st.dev / Dribbble fintech; supersedes seed 1b69662a.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->`} />
        <a class="skip" href="#main">Hoppa till innehållet</a>
        {
            FLAGS.preview && (
                <div class="env-banner">
                    Förhandsversion – inte publicerad, inte indexerad. Dataset: <code>{process.env.SE_DATA_SOURCE ?? 'CURRENT'}</code>
                </div>
            )
        }
        <Nav current={path} />
        <main id="main">
            <slot />
        </main>
        <Footer />
        <Analytics />
        <script>
            import '../scripts/motion.ts'
        </script>
    </body>
</html>

<style>
    .env-banner {
        position: relative;
        z-index: 40;
        background: var(--night);
        color: var(--ice-2);
        font-size: 0.78rem;
        padding: 7px var(--gutter);
        text-align: center;
        border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }
    .env-banner code {
        font-family: var(--mono);
    }
</style>
