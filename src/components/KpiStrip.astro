---
// Newest-year key figures and prior-year change, shown at their actual values.
import type { FiscalPeriod, Value } from '../lib/contract/types.ts'
import { compactSek, count, percent, type Display } from '../lib/format.ts'
import { metricsOf, numeric, periodsConsecutive } from '../lib/metrics.ts'

interface Props {
    periods: FiscalPeriod[]
}
const { periods } = Astro.props
const [p, prior] = periods
const m = metricsOf(p)
const mPrior = prior ? metricsOf(prior) : undefined

const fmt = (d: number, unit: string) => ({ text: `${d >= 0 ? '+' : '−'}${Math.abs(d).toLocaleString('sv-SE', { maximumFractionDigits: 1, minimumFractionDigits: 1 })} ${unit}`, up: d >= 0 })
// Sales change is the CV's omsättningstillväxt; ratio changes need the directly preceding year.
const growth = (g: Value): { text: string; up: boolean } | null => {
    const d = numeric(g)
    return d === undefined ? null : fmt(d * 100, '%')
}
const ppDelta = (a: Value, b: Value | undefined): { text: string; up: boolean } | null => {
    const x = numeric(a)
    const y = numeric(b)
    if (x === undefined || y === undefined || !periodsConsecutive(p, prior)) return null
    return fmt((x - y) * 100, 'p.e.')
}
const cells: { label: string; d: Display; delta: ReturnType<typeof growth> }[] = [
    { label: 'Nettoomsättning', d: compactSek(p.income.netSales), delta: numeric(p.income.netSales) === undefined ? null : growth(m.revenueGrowth) },
    { label: 'Rörelseresultat', d: compactSek(p.income.operatingProfit), delta: null },
    { label: 'Årets resultat', d: compactSek(p.income.netProfit), delta: null },
    { label: 'Soliditet', d: percent(m.equityRatio), delta: ppDelta(m.equityRatio, mPrior?.equityRatio) },
    { label: 'Kassalikviditet', d: percent(m.quickRatio, 0), delta: null },
    { label: 'Anställda', d: count(p.employees), delta: null },
]
---

<dl class="kpi">
    {
        cells.map((c) => (
            <div class="kpi__cell">
                <dt>{c.label}</dt>
                <dd class:list={['kpi__v', 'num', `val--${c.d.state}`]} title={c.d.note}>
                    {c.d.text}
                </dd>
                {c.d.note && <dd class="visually-hidden">{c.d.note}</dd>}
                {c.delta && <dd class:list={['kpi__d', 'num', c.delta.up ? 'is-up' : 'is-down']}>{c.delta.text}</dd>}
            </div>
        ))
    }
</dl>

<style>
    .kpi {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 10px;
        margin: 0;
    }
    .kpi__cell {
        padding: 1rem 1rem 0.875rem;
        border-radius: 8px;
        background: var(--night-2);
        border: 1px solid rgb(255 255 255 / 0.12);
    }
    .kpi dt {
        font-size: 0.8125rem;
        color: var(--ice-2);
        line-height: 1.4;
        overflow-wrap: anywhere;
    }
    .kpi dd {
        margin: 0;
    }
    .kpi__v {
        margin-top: 6px !important;
        font-size: 1.45rem;
        font-weight: 450;
        color: var(--ice);
        overflow-wrap: anywhere;
    }
    .kpi__v.val--negative {
        color: var(--red);
    }
    .kpi__v.val--missing,
    .kpi__v.val--incomparable {
        font-size: 1rem;
        color: var(--gold);
        text-decoration-color: rgb(244 191 114 / 0.5);
        padding-top: 6px;
    }
    .kpi__d {
        margin-top: 6px !important;
        display: inline-flex;
        align-items: center;
        min-height: 1.25rem;
        padding: 0.15em 0.5em;
        border: 1px solid rgb(255 255 255 / 0.22);
        border-radius: 3px;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.02em;
    }
    .kpi__d.is-up {
        color: var(--glow);
    }
    .kpi__d.is-down {
        color: #f1a198;
    }
    @media (max-width: 1100px) {
        .kpi {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    @media (max-width: 560px) {
        .kpi {
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 7.25rem), 1fr));
        }
        .kpi__cell { padding: 0.875rem 0.75rem; }
        .kpi__v {
            font-size: 1.25rem;
        }
    }
    @media (prefers-contrast: more) {
        .kpi__cell { border-color: var(--ice-2); }
        .kpi dt { color: var(--ice); }
    }
</style>
