---
import Page from '../layouts/Page.astro'
import HubStats from './HubStats.astro'
import CompanyTable from './CompanyTable.astro'
import Icon from './Icon.astro'
import Pagination from './Pagination.astro'
import { HUB_PAGE_SIZE, pageRows, pagePath } from '../lib/pagination.ts'
import { bankruptcyRows, bankruptcyHubPath } from '../lib/bankruptcy.ts'
import { SITE } from '../config/site.ts'
import { MIN_HUB_COMPANIES, type Hub, type Site } from '../lib/publish.ts'
import { kommunName } from '../lib/format.ts'

interface Props {
    hub: Hub
    site: Site
    page?: number
}
const { hub, site, page = 1 } = Astro.props
const isIndustry = hub.kind === 'bransch'
const base = isIndustry ? '/branscher/' : '/kommuner/'
const title = (isIndustry ? `${hub.name} – företag och nyckeltal` : `Företag i ${kommunName(hub.name)}`) + (page > 1 ? ` – sida ${page}` : '')
const h1 = isIndustry ? hub.name : `Företag i ${kommunName(hub.name)}`
const lede = isIndustry
    ? `Företag med huvudbransch SNI ${hub.code}, ${hub.name.toLowerCase()}, med bokslut och nyckeltal från senaste räkenskapsåret.`
    : `Företag med säte i ${kommunName(hub.name)}${hub.detail ? `, ${hub.detail}` : ''}, med bokslut och nyckeltal från senaste räkenskapsåret.`
// Cross links: where companies in this industry sit, or which industries this municipality has.
const cross = new Map<string, { href: string; label: string; n: number }>()
const listed = pageRows(hub.companies, page, HUB_PAGE_SIZE)
const canonicalBase = `${base}${hub.slug}/`
const pageIndexable = hub.indexable && (page === 1 || listed.filter((c) => c.ix).length >= MIN_HUB_COMPANIES)
const bankruptcies = bankruptcyRows(hub.companies, SITE.asOf)
if (page === 1) {
    const kommunHubs = new Map(site.municipalities.map((h) => [h.code, h]))
    const industryHubs = new Map(site.industries.map((h) => [h.code, h]))
    for (const c of hub.companies) {
        const other = isIndustry
            ? c.k && kommunHubs.get(c.k.code)
            : c.s && industryHubs.get(c.s.code)
        if (!other) continue
        const href = `${isIndustry ? '/kommuner/' : '/branscher/'}${other.slug}/`
        const e = cross.get(href) ?? { href, label: other.name, n: 0 }
        e.n++
        cross.set(href, e)
    }
}
const crossList = [...cross.values()].sort((a, b) => b.n - a.n)
---

<Page
    title={title}
    h1={page > 1 ? `${h1} – sida ${page}` : h1}
    description={lede}
    path={pagePath(canonicalBase, page)}
    lede={lede}
    noindex={!pageIndexable}
    crumbs={[{ href: base, label: isIndustry ? 'Branscher' : 'Kommuner' }, { label: hub.name }]}
>
    <div class="hd">
        {page === 1 && <HubStats companies={hub.companies} no="Tabell 1" title={isIndustry ? 'Branschen i siffror' : 'Kommunens företag i siffror'} />}
        {bankruptcies.length > 0 && <p><a href={bankruptcyHubPath(hub)}>{bankruptcies.length} företag med konkursstatus i underlaget</a>. Statusen gäller senast hämtade uppgifter, inte alla konkurser under en viss period.</p>}
        {
            !hub.substantial && (
                <div class="notice" role="note">
                    <Icon name="info" />
                    <p>
                        Färre än {MIN_HUB_COMPANIES} företag med tillräckliga uppgifter. Sidan visas för besökare men indexeras inte förrän underlaget är större.
                    </p>
                </div>
            )
        }
        <Pagination base={canonicalBase} page={page} count={hub.companies.length} size={HUB_PAGE_SIZE} />
        <CompanyTable
            companies={listed}
            no="Tabell 2"
            title={listed.length < hub.companies.length ? `Företag ${(page - 1) * HUB_PAGE_SIZE + 1}–${(page - 1) * HUB_PAGE_SIZE + listed.length} av ${hub.companies.length.toLocaleString('sv-SE')}, efter nettoomsättning` : `Företag, sorterade efter nettoomsättning`}
            source={`${site.synthetic ? 'Syntetiska testdata' : 'Bolagsverket'}, senaste inlämnade årsredovisning per företag. Äldre bokslut markeras i sista kolumnen.`}
            show={isIndustry ? 'kommun' : 'bransch'}
        />
        <Pagination base={canonicalBase} page={page} count={hub.companies.length} size={HUB_PAGE_SIZE} />
        {
            crossList.length > 0 && (
                <section>
                    <h2>{isIndustry ? 'Kommuner i branschen' : 'Branscher i kommunen'}</h2>
                    <ul class="hd__cross">
                        {crossList.map((x) => (
                            <li>
                                <a href={x.href}>{x.label}</a> <span class="muted num">{x.n}</span>
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }
    </div>
</Page>

<style>
    .hd {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(40px, 5vw, 64px);
    }
    .hd h2 {
        font-size: var(--step-2);
        margin-bottom: 16px;
    }
    .hd__cross {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 24px;
    }
</style>
