---
// Accessible combobox (WAI-ARIA 1.2 pattern). Works without JS as a plain GET
// form to /sok/; with JS it suggests companies as you type. On dark surfaces
// it renders as glass, and `typing` cycles example queries in the placeholder.
import Icon from './Icon.astro'

interface Props {
    size?: 'hero' | 'page'
    id?: string
    value?: string
    typing?: string[]
}
const { size = 'page', id = 'q', value = '', typing = [] } = Astro.props
const endpoint = process.env.PUBLIC_SE_SEARCH_ENDPOINT ?? ''
---

<form
    class:list={['sbox', `sbox--${size}`]}
    action="/sok/"
    method="get"
    role="search"
    data-search
    data-endpoint={endpoint}
    data-typing={typing.length ? JSON.stringify(typing) : undefined}
>
    <label class="sbox__label visually-hidden" for={id}>Sök på företagsnamn eller organisationsnummer</label>
    <div class="sbox__field">
        <Icon name="search" class="sbox__icon" />
        <input
            id={id}
            name="q"
            type="search"
            value={value}
            placeholder="Företagsnamn eller org.nr"
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls={`${id}-list`}
        />
        <kbd class="sbox__kbd" aria-hidden="true">/</kbd>
        <button class="sbox__go" type="submit">
            <span>Sök</span>
            <Icon name="arrow" />
        </button>
    </div>
    <ul class="sbox__list" id={`${id}-list`} role="listbox" aria-label="Förslag" hidden></ul>
    <p class="sbox__status visually-hidden" aria-live="polite"></p>
</form>

<script>
    import { searchIndex, type SearchHit } from '../lib/search.ts'
    import { formatOrgnr } from '../lib/orgnr.ts'

    let indexPromise: Promise<SearchHit[]> | null = null
    const loadIndex = () => (indexPromise ??= fetch('/sok/index.json').then((r) => (r.ok ? r.json() : [])).catch(() => []))
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

    const STATUS: Record<string, string> = { liquidation: 'I likvidation', bankruptcy: 'Konkurs', reconstruction: 'Rekonstruktion', deregistered: 'Avregistrerat' }

    // "/" focuses the first search box on the page.
    addEventListener('keydown', (e) => {
        if (e.key !== '/' || e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return
        const input = document.querySelector<HTMLInputElement>('[data-search] input')
        if (input) {
            e.preventDefault()
            input.focus()
        }
    })

    for (const form of document.querySelectorAll<HTMLFormElement>('[data-search]')) {
        const input = form.querySelector('input')!
        const list = form.querySelector<HTMLUListElement>('[role=listbox]')!
        const status = form.querySelector('.sbox__status')!
        const endpoint = form.dataset.endpoint
        let hits: SearchHit[] = []
        let active = -1
        let seq = 0

        // Typewriter placeholder: types and erases example queries while idle.
        const examples: string[] = form.dataset.typing ? JSON.parse(form.dataset.typing) : []
        if (examples.length && !reduce) {
            const base = input.placeholder
            let ex = 0
            let pos = 0
            let dir = 1
            let timer = 0
            const step = () => {
                if (document.activeElement === input || input.value) {
                    input.placeholder = base
                    timer = window.setTimeout(step, 600)
                    return
                }
                const word = examples[ex]
                pos += dir
                input.placeholder = word.slice(0, pos) + (dir > 0 ? '▍' : '')
                let wait = dir > 0 ? 55 + Math.random() * 60 : 22
                if (pos >= word.length) {
                    dir = -1
                    wait = 1700
                } else if (pos <= 0) {
                    dir = 1
                    ex = (ex + 1) % examples.length
                    wait = 400
                }
                timer = window.setTimeout(step, wait)
            }
            timer = window.setTimeout(step, 900)
            input.addEventListener('focus', () => (input.placeholder = base))
            void timer
        }

        const close = () => {
            list.hidden = true
            input.setAttribute('aria-expanded', 'false')
            input.removeAttribute('aria-activedescendant')
            active = -1
        }
        const setActive = (i: number) => {
            active = i
            list.querySelectorAll('[role=option]').forEach((el, j) => el.setAttribute('aria-selected', String(j === i)))
            if (i >= 0) input.setAttribute('aria-activedescendant', `${list.id}-${i}`)
            else input.removeAttribute('aria-activedescendant')
        }
        const render = () => {
            list.replaceChildren(
                ...hits.map((h, i) => {
                    const li = document.createElement('li')
                    li.id = `${list.id}-${i}`
                    li.setAttribute('role', 'option')
                    li.setAttribute('aria-selected', 'false')
                    const a = document.createElement('a')
                    a.href = h.p
                    a.tabIndex = -1
                    const name = document.createElement('span')
                    name.className = 'sbox__name'
                    name.textContent = h.n
                    const meta = document.createElement('span')
                    meta.className = 'sbox__meta'
                    meta.textContent = [formatOrgnr(h.o), h.k, h.st && STATUS[h.st]].filter(Boolean).join(' · ')
                    a.append(name, meta)
                    li.append(a)
                    li.addEventListener('mousedown', (e) => e.preventDefault())
                    return li
                }),
            )
            const open = hits.length > 0
            list.hidden = !open
            input.setAttribute('aria-expanded', String(open))
            status.textContent = input.value.trim().length >= 2 ? (open ? `${hits.length} förslag` : 'Inga förslag') : ''
            setActive(-1)
        }
        const query = async () => {
            const q = input.value
            const mine = ++seq
            let res: SearchHit[]
            if (endpoint) {
                res = q.trim().length < 2 ? [] : await fetch(`${endpoint}?q=${encodeURIComponent(q)}`).then((r) => (r.ok ? r.json() : [])).catch(() => [])
            } else {
                res = searchIndex(await loadIndex(), q)
            }
            if (mine !== seq) return
            hits = res
            render()
        }
        let t: number | undefined
        input.addEventListener('input', () => {
            clearTimeout(t)
            t = window.setTimeout(query, endpoint ? 160 : 40)
        })
        input.addEventListener('focus', () => {
            if (!endpoint) loadIndex()
            if (hits.length) render()
        })
        input.addEventListener('blur', () => setTimeout(close, 120))
        input.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowDown' && hits.length) {
                e.preventDefault()
                if (list.hidden) render()
                setActive((active + 1) % hits.length)
            } else if (e.key === 'ArrowUp' && hits.length) {
                e.preventDefault()
                setActive(active <= 0 ? hits.length - 1 : active - 1)
            } else if (e.key === 'Escape') {
                if (!list.hidden) {
                    e.preventDefault()
                    close()
                }
            } else if (e.key === 'Enter' && active >= 0) {
                e.preventDefault()
                location.href = hits[active].p
            }
        })
    }
</script>

<style>
    .sbox {
        position: relative;
    }
    .sbox__field {
        position: relative;
        display: flex;
        align-items: center;
        background: var(--sheet);
        border: 1px solid var(--rule-2);
        border-radius: 6px;
        background: #fff;
        box-shadow: 0 1px 2px rgb(15 33 26 / 0.06), 0 16px 32px -24px rgb(15 33 26 / 0.35);
        transition:
            border-color 200ms var(--ease-out),
            box-shadow 200ms var(--ease-out);
    }
    .sbox__field:focus-within {
        border-color: var(--blue);
        box-shadow:
            0 0 0 4px var(--blue-3),
            var(--card-shadow);
    }
    :global(.dark) .sbox__field {
        background: var(--night-2);
        border-color: rgb(255 255 255 / 0.18);
        box-shadow:
            inset 0 1px 0 rgb(255 255 255 / 0.14),
            0 30px 60px -30px rgb(0 0 0 / 0.8);
    }
    .sbox__field :global(.sbox__icon) {
        position: absolute;
        left: 20px;
        width: 20px;
        height: 20px;
        color: var(--ink-3);
        pointer-events: none;
    }
    .sbox input {
        flex: 1;
        min-width: 0;
        border: 0;
        background: transparent;
        font: inherit;
        color: var(--ink);
        padding: 0 12px 0 52px;
        height: 52px;
        font-size: 1rem;
        outline: none;
    }
    .sbox input::placeholder {
        color: var(--ink-3);
    }
    :global(.dark) .sbox input::placeholder {
        color: var(--ice-2);
    }
    .sbox input::-webkit-search-cancel-button {
        filter: grayscale(1);
    }
    .sbox__kbd {
        display: grid;
        place-items: center;
        width: 24px;
        height: 24px;
        border-radius: 3px;
        border: 1px solid var(--rule-2);
        font: 500 0.72rem var(--sans);
        color: var(--ink-3);
        margin-right: 8px;
    }
    .sbox__go {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: calc(100% - 12px);
        min-height: 44px;
        margin: 5px;
        padding: 0 18px;
        border: 0;
        border-radius: 4px;
        background: var(--forest);
        color: #f3f6f2;
        font: 500 0.875rem var(--sans);
        cursor: pointer;
        transition: translate 180ms var(--ease-out);
    }
    :global(.dark) .sbox__go {
        background: #f3f6f2;
        color: var(--night);
    }
    .sbox__go:hover {
        translate: 0 -1px;
    }
    .sbox__go :global(svg) {
        width: 16px;
        height: 16px;
    }
    .sbox--hero input {
        height: 60px;
        font-size: 1.05rem;
        padding-left: 58px;
    }
    .sbox--hero .sbox__field :global(.sbox__icon) {
        left: 24px;
    }
    .sbox__list {
        position: absolute;
        z-index: 30;
        left: 0;
        right: 0;
        top: calc(100% + 8px);
        margin: 0;
        padding: 6px;
        list-style: none;
        background: #fff;
        color: #0a1426;
        border: 1px solid #dde3ed;
        border-radius: 8px;
        box-shadow: 0 30px 60px -20px rgb(15 33 26 / 0.35);
        max-height: min(420px, 60vh);
        overflow-y: auto;
    }
    .sbox__list :global(a) {
        display: grid;
        gap: 2px;
        padding: 10px 14px;
        border-radius: 4px;
        color: #0f211a;
        text-decoration: none;
    }
    .sbox__list :global([aria-selected='true'] a),
    .sbox__list :global(a:hover) {
        background: #e4ede6;
    }
    .sbox__list :global(.sbox__name) {
        font-weight: 600;
    }
    .sbox__list :global(.sbox__meta) {
        font-size: var(--step--1);
        color: #5d6b64;
    }
    @media (max-width: 560px) {
        .sbox__go span,
        .sbox__kbd {
            display: none;
        }
        .sbox--hero input {
            height: 60px;
            font-size: 1rem;
            padding-left: 50px;
        }
        .sbox--hero .sbox__field :global(.sbox__icon) {
            left: 18px;
        }
    }
</style>
