---
import { FLAGS, SITE } from '../config/site.ts'
import LogoMark from './LogoMark.astro'
const year = SITE.asOf.slice(0, 4)
const cols = [
    { h: 'Utforska', links: [['/sok/', 'Sök företag'], ['/branscher/', 'Branscher'], ['/kommuner/', 'Kommuner'], ['/topplistor/', 'Topplistor'], ['/senast-uppdaterade/', 'Senast uppdaterade'], ['/guider/', 'Guider']] },
    { h: 'Rapporter', links: [['/rapporter/', 'Bas och AI jämförda'], ['/rapporter/exempel/', 'Exempelrapporter'], ['/metod/', 'Metod'], ['/kallor/', 'Datakällor'], ['/fragor/', 'Vanliga frågor']] },
    { h: 'Om tjänsten', links: [['/om/', 'Leverantör och kontakt'], ['/integritet/', 'Integritetspolicy'], ['/villkor/', 'Användarvillkor'], ['/leverans/', 'Leverans och ångerrätt']] },
]
---

<footer class="foot dark">
    <div class="shell foot__grid">
        <div class="foot__brand">
            <a href="/" class="foot__name"><LogoMark tone="dark" />{SITE.name}</a>
            <p>Bokslut, nyckeltal och kreditrisk för svenska företag. <span class="tone">Byggt av {SITE.provider.name}.</span></p>
        </div>
        {
            cols.map((c) => (
                <nav aria-label={c.h} class="foot__col">
                    <h2>{c.h}</h2>
                    <ul>
                        {c.links.map(([href, label]) => (
                            <li>
                                <a href={href}>{label}</a>
                            </li>
                        ))}
                    </ul>
                </nav>
            ))
        }
    </div>
    <div class="shell foot__base">
        <span>© {year} {SITE.provider.name} · FO-nummer {SITE.provider.businessId}</span>
        {!FLAGS.checkout && <span>Tjänsten är under uppbyggnad. Inga rapporter om svenska företag säljs ännu.</span>}
        <span>Foton: Unsplash</span>
        <button type="button" class="foot__consent" data-consent-open hidden>Cookieinställningar</button>
    </div>
</footer>

<style>
    .foot {
        position: relative;
        padding-top: clamp(64px, 8vw, 104px);
        background: var(--night);
    }
    .foot__grid {
        display: grid;
        grid-template-columns: 1.6fr repeat(3, 1fr);
        gap: 40px 24px;
        padding-bottom: 64px;
    }
    .foot .foot__name {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--ice);
        text-decoration: none;
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: -0.04em;
    }
    .foot__brand p {
        margin-top: 14px;
        color: var(--ice-2);
        max-width: 30ch;
        font-size: 1.05rem;
        line-height: 1.35;
        letter-spacing: -0.015em;
    }
    .foot h2 {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ice-3);
        margin-bottom: 14px;
    }
    .foot ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 9px;
    }
    .foot a {
        color: var(--ice-2);
        text-decoration: none;
        font-size: 0.92rem;
        transition: color 160ms;
    }
    .foot a:hover {
        color: var(--ice);
    }
    .foot__base {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 24px;
        border-top: 1px solid rgb(255 255 255 / 0.1);
        padding-block: 22px 28px;
        color: var(--ice-3);
        font-size: 0.78rem;
    }
    .foot__consent {
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font: inherit;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
    }
    @media (max-width: 860px) {
        .foot__grid {
            grid-template-columns: 1fr 1fr;
        }
        .foot__brand {
            grid-column: 1 / -1;
        }
    }
</style>
