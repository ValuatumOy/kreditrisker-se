---
import { FLAGS, SITE } from '../config/site.ts'
const year = SITE.asOf.slice(0, 4)
const cols = [
    { h: 'Utforska', links: [['/sok/', 'Sök företag'], ['/branscher/', 'Branscher'], ['/kommuner/', 'Kommuner'], ['/topplistor/', 'Topplistor'], ['/guider/', 'Guider']] },
    { h: 'Rapporter', links: [['/rapporter/', 'Bas och AI jämförda'], ['/rapporter/exempel/', 'Exempelrapporter'], ['/metod/', 'Metod'], ['/kallor/', 'Datakällor'], ['/fragor/', 'Vanliga frågor']] },
    { h: 'Om tjänsten', links: [['/om/', 'Leverantör och kontakt'], ['/integritet/', 'Integritetspolicy'], ['/villkor/', 'Användarvillkor'], ['/leverans/', 'Leverans och ångerrätt']] },
]
---

<footer class="foot dark grain">
    <div class="shell foot__grid">
        <div class="foot__brand">
            <a href="/" class="foot__logo"><span>{SITE.name}</span></a>
            <p>Bokslut, nyckeltal och kreditrisk för svenska företag. Byggt av {SITE.provider.name}.</p>
        </div>
        {
            cols.map((c) => (
                <nav aria-label={c.h} class="foot__col">
                    <h2>{c.h}</h2>
                    <ul>
                        {c.links.map(([href, label]) => (
                            <li>
                                <a href={href}>{label}</a>
                            </li>
                        ))}
                    </ul>
                </nav>
            ))
        }
    </div>
    <div class="shell foot__base">
        <span>© {year} {SITE.provider.name} · FO-nummer {SITE.provider.businessId}</span>
        {!FLAGS.checkout && <span>Tjänsten är under uppbyggnad. Inga rapporter om svenska företag säljs ännu.</span>}
        <span>Foton: Unsplash</span>
    </div>
</footer>

<style>
    .foot {
        position: relative;
        overflow: hidden;
        padding-top: clamp(64px, 8vw, 104px);
        background:
            radial-gradient(80% 60% at 20% 0%, rgb(42 91 184 / 0.22), transparent 60%),
            var(--night);
        border-top: 1px solid rgb(255 255 255 / 0.06);
    }
    .foot__grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1.6fr repeat(3, 1fr);
        gap: 40px 24px;
        padding-bottom: 56px;
    }
    .foot__logo {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: var(--ice);
        text-decoration: none;
        font-family: var(--serif);
        font-size: 1.6rem;
        letter-spacing: -0.02em;
    }
    .foot__brand p {
        margin-top: 16px;
        color: var(--ice-3);
        max-width: 34ch;
        font-size: 0.95rem;
    }
    .foot h2 {
        font-family: var(--sans);
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--ice-3);
        margin-bottom: 14px;
        letter-spacing: 0;
    }
    .foot ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 10px;
    }
    .foot a {
        color: var(--ice-2);
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 160ms;
    }
    .foot a:hover {
        color: var(--ice);
    }
    .foot__base {
        position: relative;
        z-index: 1;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 24px;
        border-top: 1px solid rgb(255 255 255 / 0.08);
        padding-block: 22px;
        color: var(--ice-3);
        font-size: 0.8rem;
    }
    .foot__word {
        font-family: var(--serif);
        font-weight: 300;
        font-size: clamp(5rem, 20vw, 18rem);
        line-height: 0.8;
        letter-spacing: -0.06em;
        text-align: center;
        margin: 12px 0 -0.12em;
        color: rgb(238 243 250 / 0.07);
        user-select: none;
        white-space: nowrap;
    }
    @media (max-width: 860px) {
        .foot__grid {
            grid-template-columns: 1fr 1fr;
        }
        .foot__brand {
            grid-column: 1 / -1;
        }
    }
</style>
