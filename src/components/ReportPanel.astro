---
// Report CTAs on a company profile. Basic and AI each render their own state.
import type { PublishedCompany } from '../lib/contract/types.ts'
import { staticReportState } from '../lib/reports/availability.ts'
import { PRODUCT_NAME, STATE_LABEL, UNAVAILABLE_TEXT } from '../lib/reports/labels.ts'
import type { ReportProduct } from '../lib/reports/types.ts'
import Icon from './Icon.astro'

interface Props {
    company: PublishedCompany
}
const { company } = Astro.props
const DESC: Record<ReportProduct, string> = {
    basic: 'Bokslut, nyckeltal och branschjämförelse samlade i en rapport.',
    ai: 'Som basrapporten, med en skriven analys och genomgång av offentliga källor.',
}
const products = (['basic', 'ai'] as const).map((p) => ({ p, s: staticReportState(p, company) }))
// The basic report is generated from Valuatum's model id (API data carries it as fid:N).
const fid = company.record.status.source.documentId?.match(/^fid:(\d+)$/)?.[1]
const orderHref = (p: ReportProduct) => `/bestall/?orgnr=${company.record.orgnr}&produkt=${p === 'basic' ? 'bas' : 'ai'}${fid ? `&fid=${fid}` : ''}`
---

<aside class="rp dark grain" aria-labelledby="rp-title">
    <h2 id="rp-title" class="rp__title">Rapport om {company.record.name}</h2>
    <ul class="rp__list">
        {
            products.map(({ p, s }) => (
                <li class="rp__item">
                    <div class="rp__row">
                        <h3>{PRODUCT_NAME[p]}</h3>
                        <span class:list={['tag', s.kind === 'available' ? 'tag--ok' : 'tag--warn']}>{STATE_LABEL[s.kind]}</span>
                    </div>
                    <p class="rp__desc">{DESC[p]}</p>
                    {s.kind === 'available' && (
                        <>
                            {s.price && (
                                <p class="rp__price num">
                                    {s.price.amountSek.toLocaleString('sv-SE')} kr <span class="muted small">{s.price.vatIncluded ? 'inkl. moms' : 'exkl. moms'}</span>
                                </p>
                            )}
                            <a class="btn" href={orderHref(p)}>
                                Beställ {PRODUCT_NAME[p].toLowerCase()} <Icon name="arrow" />
                            </a>
                        </>
                    )}
                    {s.kind === 'sample' && (
                        <a class="btn btn--quiet" href={s.sampleHref}>
                            <Icon name="doc" /> Se exempelrapport
                        </a>
                    )}
                    {s.kind === 'unavailable' && (
                        <p class="rp__state small">
                            <Icon name="clock" />
                            <span>{UNAVAILABLE_TEXT[s.reason]}</span>
                        </p>
                    )}
                </li>
            ))
        }
    </ul>
    <p class="rp__foot small">
        <a href="/rapporter/">Jämför rapporterna</a> · <a href="/rapporter/exempel/">Exempel</a>
    </p>
</aside>

<style>
    .rp {
        position: relative;
        overflow: hidden;
        overflow-wrap: anywhere;
        padding: 22px 22px 18px;
        border-radius: 14px;
        background:
            radial-gradient(120% 80% at 100% 0%, rgb(43 84 68 / 0.7), transparent 60%),
            radial-gradient(90% 60% at 0% 100%, rgb(244 191 114 / 0.12), transparent 60%),
            var(--night-2);
        border: 1px solid rgb(255 255 255 / 0.08);
        box-shadow: 0 40px 80px -40px rgb(10 20 38 / 0.6);
    }
    .rp__title {
        font-family: var(--sans);
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: 0;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }
    .rp__list {
        list-style: none;
        margin: 14px 0 0;
        padding: 0;
    }
    .rp__item {
        min-width: 0;
        grid-template-columns: minmax(0, 1fr);
        padding: 16px;
        margin-bottom: 8px;
        border-radius: 8px;
        background: rgb(255 255 255 / 0.05);
        border: 1px solid rgb(255 255 255 / 0.08);
        display: grid;
        gap: 10px;
        justify-items: start;
    }
    .rp :global(.tag) {
        height: auto;
        min-height: 1.375rem;
        padding-block: 0.35em;
        white-space: normal;
        line-height: 1.4;
    }
    .rp__row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        width: 100%;
    }
    .rp__row h3 {
        font-size: 1.5rem;
        font-weight: 350;
    }
    .rp__desc {
        color: var(--ink-2);
        font-size: 0.95rem;
    }
    .rp__price {
        font-family: var(--serif);
        font-size: 1.5rem;
    }
    .rp__state {
        display: flex;
        gap: 8px;
        color: var(--ink-3);
    }
    .rp__state :global(svg) {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        margin-top: 2px;
    }
    .rp__foot {
        padding-top: 12px;
        border-top: 1px solid var(--rule);
        color: var(--ink-3);
    }
    .rp :global(.btn) { min-height: 2.75rem; }
    .rp__foot a {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
    }
    @media (prefers-contrast: more) {
        .rp, .rp__item { border-color: var(--ice-2); }
        .rp__desc, .rp__state { color: var(--ice); }
    }
</style>
