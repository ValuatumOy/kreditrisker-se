---
const id = import.meta.env.PUBLIC_GA_TRACKING_ID || ''
const frameOrigin = import.meta.env.PUBLIC_GA_FRAME_ORIGIN || ''
---

{
    id && frameOrigin && (
        <>
            <aside id="consent" class="consent" aria-label="Cookieinställningar" data-frame-origin={frameOrigin} data-analytics-id={id} hidden>
                <p>
                    Vi vill använda Google Analytics för att se hur sajten används. Det sätter kakor och sker bara om du godkänner. <a href="/integritet/#kakor">Läs mer</a>
                </p>
                <div class="consent__actions">
                    <button type="button" class="btn btn--quiet" data-reject>Avvisa</button>
                    <button type="button" class="btn btn--quiet" data-accept>Godkänn</button>
                </div>
            </aside>
        </>
    )
}

<script>
    import { ANALYTICS_EVENTS, analyticsPage, analyticsReferrer, type AnalyticsEvent } from '../lib/analytics.ts'

    const banner = document.querySelector<HTMLElement>('#consent')
    if (banner) {
        const consentKey = 'kreditrisker_consent'
        const searchKey = 'kreditrisker_analytics_search'
        const returnKey = 'kreditrisker_analytics_return'
        let frame: HTMLIFrameElement | null = null
        let ready = false
        let waiting: AnalyticsEvent[] = []
        const get = (storage: Storage, key: string) => { try { return storage.getItem(key) } catch { return null } }
        const set = (storage: Storage, key: string, value: string) => { try { storage.setItem(key, value) } catch {} }
        const remove = (storage: Storage, key: string) => { try { storage.removeItem(key) } catch {} }
        const consent = () => get(localStorage, consentKey) === 'granted'

        function send(name: AnalyticsEvent) {
            if (!consent() || !ANALYTICS_EVENTS.includes(name)) return
            if (frame && ready) frame.contentWindow?.postMessage({ type: 'event', name }, '*')
            else waiting.push(name)
        }

        function load() {
            if (frame || !consent()) return
            let frameUrl: URL
            try {
                frameUrl = new URL('/analytics-frame/', banner.dataset.frameOrigin)
                const local = ['127.0.0.1', 'localhost'].includes(frameUrl.hostname) && ['127.0.0.1', 'localhost'].includes(location.hostname)
                if (frameUrl.origin === location.origin || (frameUrl.protocol !== 'https:' && !local)) return
            } catch { return }
            frame = document.createElement('iframe')
            frame.hidden = true
            frame.setAttribute('title', 'Statistik')
            frame.setAttribute('sandbox', 'allow-scripts allow-same-origin')
            frame.referrerPolicy = 'no-referrer'
            frame.src = frameUrl.href
            frame.addEventListener('load', () => {
                if (!frame || !consent()) return
                frame.contentWindow?.postMessage({ type: 'init', page: analyticsPage(location.pathname), referrer: analyticsReferrer(document.referrer) }, '*')
                ready = true
                if (get(sessionStorage, searchKey) === '1') {
                    remove(sessionStorage, searchKey)
                    send('search_started')
                }
                if (analyticsPage(location.pathname) === 'checkout' && new URLSearchParams(location.search).get('checkout') === 'success' && get(sessionStorage, returnKey) !== '1') {
                    set(sessionStorage, returnKey, '1')
                    send('checkout_returned')
                }
                const pending = waiting
                waiting = []
                pending.forEach(send)
            })
            document.body.appendChild(frame)
        }

        const open = () => { banner.hidden = false }
        if (consent()) load()
        else if (get(localStorage, consentKey) !== 'denied') open()
        banner.querySelector('[data-accept]')?.addEventListener('click', () => {
            set(localStorage, consentKey, 'granted')
            banner.hidden = true
            load()
        })
        function stop() {
            for (const name of ['_ga', `_ga_${banner.dataset.analyticsId?.slice(2) ?? ''}`]) {
                document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`
                if (location.hostname.endsWith('.kreditrisker.se')) document.cookie = `${name}=; Max-Age=0; path=/; domain=kreditrisker.se; Secure; SameSite=Lax`
            }
            remove(sessionStorage, searchKey)
            remove(sessionStorage, returnKey)
            frame?.remove()
            frame = null
            ready = false
            waiting = []
            banner.hidden = true
        }
        banner.querySelector('[data-reject]')?.addEventListener('click', () => {
            set(localStorage, consentKey, 'denied')
            stop()
        })
        addEventListener('storage', (event) => { if (event.key === consentKey && event.newValue !== 'granted') stop() })
        document.querySelectorAll<HTMLElement>('[data-consent-open]').forEach((button) => { button.hidden = false; button.addEventListener('click', open) })
        const queueSearch = () => { if (consent()) set(sessionStorage, searchKey, '1') }
        document.addEventListener('submit', (event) => { if ((event.target as Element)?.matches('[data-search]')) queueSearch() })
        document.addEventListener('click', (event) => { if ((event.target as Element)?.closest('[data-search] [role=option] a')) queueSearch() })
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' && (event.target as Element)?.matches('[data-search] input[aria-activedescendant]')) queueSearch()
        }, true)
        window.addEventListener('kreditrisker:analytics', (event) => {
            const name = (event as CustomEvent).detail
            if (name === 'checkout_submitted') remove(sessionStorage, returnKey)
            if (ANALYTICS_EVENTS.includes(name)) send(name)
        })
    }
</script>

<style>
    .consent {
        position: fixed;
        z-index: 40;
        left: 16px;
        bottom: 16px;
        width: min(420px, calc(100vw - 32px));
        padding: 18px;
        border: 1px solid var(--rule-2);
        border-radius: var(--radius-lg);
        background: var(--sheet);
        color: var(--ink);
        box-shadow: 0 30px 60px -30px rgb(15 33 26 / 0.45);
        font-size: 0.9rem;
        line-height: 1.45;
    }
    .consent__actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 14px;
    }
</style>
