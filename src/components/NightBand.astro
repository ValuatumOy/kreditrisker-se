---
// Dark page-top band shared by inner pages and company profiles: a heavily
// shaded Stockholm dusk photo, slow drifting light, animated contour lines.
import { Picture } from 'astro:assets'
import dusk from '../assets/photos/stockholm-dusk-wide.jpg'

interface Props {
    compact?: boolean
}
const { compact = false } = Astro.props
const contours = Array.from({ length: 7 }, (_, i) => i)
---

<section class:list={['band', 'dark', 'grain', { 'band--compact': compact }]}>
    <div class="band__media" aria-hidden="true">
        <Picture src={dusk} alt="" formats={['avif', 'webp']} widths={[900, 1600, 2400]} sizes="100vw" class="band__img" />
        <svg class="band__lines" viewBox="0 0 1440 400" preserveAspectRatio="none">
            {
                contours.map((i) => (
                    <path
                        d={`M0,${250 + i * 18} C240,${210 + i * 14} 420,${300 + i * 10} 720,${240 + i * 16} S1200,${190 + i * 20} 1440,${230 + i * 14}`}
                        style={`--i:${i}`}
                    />
                ))
            }
        </svg>
        <div class="band__shade"></div>
    </div>
    <div class="shell band__inner">
        <slot />
    </div>
</section>

<style>
    .band {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        padding-top: 124px;
        padding-bottom: clamp(48px, 6vw, 80px);
    }
    .band--compact {
        padding-bottom: clamp(36px, 5vw, 56px);
    }
    .band__media {
        position: absolute;
        inset: 0;
        z-index: -1;
    }
    .band__media :global(picture),
    .band__media :global(img) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 70%;
    }
    .band__media :global(img) {
        filter: saturate(0.9);
    }
    .band__shade {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(70% 90% at 85% 100%, rgb(244 191 114 / 0.1), transparent 60%),
            linear-gradient(180deg, rgb(5 10 21 / 0.9) 0%, rgb(5 10 21 / 0.72) 45%, rgb(5 10 21 / 0.92) 100%);
    }
    .band__lines {
        position: absolute;
        inset: auto 0 0 0;
        width: 100%;
        height: 70%;
        z-index: 1;
    }
    .band__lines path {
        fill: none;
        stroke: rgb(127 178 255 / 0.14);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
    }
    @media (prefers-reduced-motion: no-preference) {
        .band__lines path {
            animation: wave 14s ease-in-out infinite alternate;
            animation-delay: calc(var(--i) * -1.6s);
        }
    }
    @keyframes wave {
        to {
            transform: translateY(-18px) scaleY(1.08);
        }
    }
    .band__inner {
        position: relative;
        z-index: 2;
    }
</style>
