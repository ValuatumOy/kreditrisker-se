---
// Forest page-top band shared by inner pages and company profiles: deep green
// ground with drifting circuit traces and a soft light from the lower right.
import Circuit from './Circuit.astro'

interface Props {
    compact?: boolean
}
const { compact = false } = Astro.props
---

<section class:list={['band', 'dark', { 'band--compact': compact }]}>
    <div class="band__media" aria-hidden="true">
        <Circuit tone="dark" />
        <div class="band__light"></div>
    </div>
    <div class="shell band__inner">
        <slot />
    </div>
</section>

<style>
    .band {
        position: relative;
        z-index: 2;
        isolation: isolate;
        margin-inline: clamp(8px, 1.4vw, 20px);
        border-radius: 20px;
        padding-top: clamp(28px, 4vw, 48px);
        padding-bottom: clamp(48px, 6vw, 80px);
        background: var(--night);
    }
    .band--compact {
        padding-bottom: clamp(36px, 5vw, 56px);
    }
    .band__media {
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        border-radius: inherit;
    }
    .band__media :global(.circuit) {
        opacity: 0.8;
        mask-image: linear-gradient(90deg, transparent 0%, #000 45%);
    }
    .band__light {
        position: absolute;
        inset: 0;
        background: radial-gradient(60% 80% at 90% 110%, rgb(159 212 176 / 0.16), transparent 70%);
    }
    .band__inner {
        position: relative;
        z-index: 2;
    }
</style>
