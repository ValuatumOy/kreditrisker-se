---
import { SITE } from '../config/site.ts'
import Icon from './Icon.astro'
import Logo from './Logo.astro'

interface Props {
    current: string
}
const { current } = Astro.props
const links = [
    { href: '/branscher/', label: 'Branscher' },
    { href: '/kommuner/', label: 'Kommuner' },
    { href: '/topplistor/', label: 'Topplistor' },
    { href: '/rapporter/', label: 'Rapporter' },
    { href: '/metod/', label: 'Metod' },
    { href: '/fragor/', label: 'Frågor' },
]
const isCurrent = (href: string) => current.startsWith(href)
---

<header class="nav dark" data-nav>
    <div class="shell nav__bar">
        <a class="nav__brand" href="/" aria-label={`${SITE.name}, till startsidan`}>
            <Logo />
            <span class="nav__name">{SITE.name}</span>
        </a>
        <nav class="nav__links" aria-label="Huvudmeny">
            <ul>
                {
                    links.map((l) => (
                        <li>
                            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                                {l.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <a class="nav__cta" href="/sok/">
            <Icon name="search" />
            <span>Sök företag</span>
        </a>
        <details class="nav__menu">
            <summary aria-label="Meny">
                <Icon name="menu" class="i-open" />
                <Icon name="close" class="i-close" />
            </summary>
            <div class="nav__sheet">
                <form action="/sok/" method="get" role="search" class="nav__sheet-search">
                    <label class="visually-hidden" for="nav-q-m">Sök företag</label>
                    <input id="nav-q-m" name="q" type="search" placeholder="Namn eller org.nr" autocomplete="off" />
                    <button class="btn" type="submit">Sök</button>
                </form>
                <ul>
                    {
                        links.map((l) => (
                            <li>
                                <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                                    {l.label}
                                </a>
                            </li>
                        ))
                    }
                    <li><a href="/om/">Om tjänsten och kontakt</a></li>
                </ul>
            </div>
        </details>
    </div>
</header>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 30;
        margin-bottom: -72px;
        background: transparent;
        transition:
            background 300ms var(--ease-out),
            border-color 300ms var(--ease-out);
        border-bottom: 1px solid transparent;
    }
    .nav:global(.is-scrolled),
    .nav:has(details[open]) {
        background: rgb(5 10 21 / 0.78);
        backdrop-filter: blur(16px) saturate(1.4);
        -webkit-backdrop-filter: blur(16px) saturate(1.4);
        border-bottom-color: rgb(255 255 255 / 0.08);
    }
    .nav__bar {
        display: flex;
        align-items: center;
        gap: 32px;
        height: 72px;
    }
    .nav__brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--ice);
        text-decoration: none;
        margin-right: auto;
        flex-shrink: 0;
    }
    .nav__name {
        font-family: var(--serif);
        font-size: 1.35rem;
        font-weight: 450;
        letter-spacing: -0.025em;
    }
    .nav__links ul {
        display: flex;
        gap: 4px;
        list-style: none;
        margin: 0;
        padding: 4px;
        border-radius: 999px;
        background: rgb(255 255 255 / 0.05);
        border: 1px solid rgb(255 255 255 / 0.08);
    }
    .nav__links a {
        display: block;
        padding: 7px 14px;
        border-radius: 999px;
        color: var(--ice-2);
        text-decoration: none;
        font-size: 0.9rem;
        transition:
            color 160ms,
            background 160ms;
    }
    .nav__links a:hover {
        color: var(--ice);
        background: rgb(255 255 255 / 0.06);
    }
    .nav__links a[aria-current='page'] {
        color: var(--night);
        background: var(--ice);
    }
    .nav__cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 40px;
        padding: 0 16px;
        border-radius: 999px;
        background: var(--ice);
        color: var(--night);
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        transition: translate 200ms var(--ease-out);
    }
    .nav__cta:hover {
        translate: 0 -1px;
    }
    .nav__cta :global(svg) {
        width: 16px;
        height: 16px;
    }
    .nav__menu {
        display: none;
    }
    .nav__menu summary {
        list-style: none;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin-right: -10px;
        cursor: pointer;
        color: var(--ice);
    }
    .nav__menu summary::-webkit-details-marker {
        display: none;
    }
    .nav__menu :global(svg) {
        width: 22px;
        height: 22px;
    }
    .nav__menu :global(.i-close),
    .nav__menu[open] :global(.i-open) {
        display: none;
    }
    .nav__menu[open] :global(.i-close) {
        display: block;
    }
    .nav__sheet {
        position: absolute;
        left: 0;
        right: 0;
        top: 72px;
        background: rgb(5 10 21 / 0.96);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgb(255 255 255 / 0.08);
        padding: 18px var(--gutter) 28px;
    }
    .nav__sheet-search {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
    }
    .nav__sheet-search input {
        flex: 1;
        min-width: 0;
        height: 46px;
        padding: 0 16px;
        border: 1px solid rgb(255 255 255 / 0.16);
        border-radius: 999px;
        background: rgb(255 255 255 / 0.06);
        color: var(--ice);
        font: inherit;
    }
    .nav__sheet ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .nav__sheet a {
        display: block;
        padding: 14px 0;
        border-bottom: 1px solid rgb(255 255 255 / 0.08);
        color: var(--ice);
        text-decoration: none;
        font-family: var(--serif);
        font-size: 1.35rem;
        font-weight: 350;
    }
    @media (max-width: 1060px) {
        .nav__links,
        .nav__cta {
            display: none;
        }
        .nav__menu {
            display: block;
        }
    }
</style>
