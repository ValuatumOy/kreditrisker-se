---
import { SITE } from '../config/site.ts'
import Icon from './Icon.astro'

interface Props {
    current: string
}
const { current } = Astro.props
const links = [
    { href: '/branscher/', label: 'Branscher' },
    { href: '/kommuner/', label: 'Kommuner' },
    { href: '/topplistor/', label: 'Topplistor' },
    { href: '/metod/', label: 'Metod' },
    { href: '/fragor/', label: 'Frågor' },
]
const isCurrent = (href: string) => current.startsWith(href)
---

<header class="nav" data-nav>
    <div class="shell nav__bar">
        <a class="nav__brand" href="/">{SITE.name}</a>
        <details class="nav__menu">
            <summary aria-label="Meny">
                <Icon name="menu" class="i-open" />
                <Icon name="close" class="i-close" />
            </summary>
            <div class="nav__sheet">
                <form action="/sok/" method="get" role="search" class="nav__sheet-search">
                    <label class="visually-hidden" for="nav-q-m">Sök företag</label>
                    <input id="nav-q-m" name="q" type="search" placeholder="Namn eller org.nr" autocomplete="off" />
                    <button class="btn" type="submit">Sök</button>
                </form>
                <ul>
                    {
                        [...links, { href: '/rapporter/', label: 'Rapporter' }, { href: '/om/', label: 'Om tjänsten' }].map((l) => (
                            <li>
                                <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                                    {l.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </details>
        <nav class="nav__links" aria-label="Huvudmeny">
            <ul>
                {
                    links.map((l) => (
                        <li>
                            <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                                {l.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <div class="nav__actions">
            <a class="btn btn--quiet nav__btn" href="/rapporter/">Rapporter</a>
            <a class="btn nav__btn" href="/sok/">Sök företag</a>
        </div>
    </div>
</header>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 30;
        background: color-mix(in srgb, var(--paper) 86%, transparent);
        backdrop-filter: blur(14px) saturate(1.3);
        -webkit-backdrop-filter: blur(14px) saturate(1.3);
        border-bottom: 1px solid transparent;
        transition: border-color 300ms var(--ease-out);
    }
    .nav:global(.is-scrolled) {
        border-bottom-color: var(--rule);
    }
    .nav__bar {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 64px;
    }
    .nav__brand {
        font-size: 1.12rem;
        font-weight: 500;
        letter-spacing: -0.04em;
        color: var(--ink);
        text-decoration: none;
    }
    .nav__links {
        margin-left: auto;
        margin-right: auto;
    }
    .nav__links ul {
        display: flex;
        gap: 2px;
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .nav__links a {
        display: block;
        padding: 7px 12px;
        border-radius: 3px;
        color: var(--ink-2);
        text-decoration: none;
        font-size: 0.875rem;
        transition:
            color 160ms,
            background 160ms;
    }
    .nav__links a:hover {
        color: var(--ink);
        background: var(--paper-2);
    }
    .nav__links a[aria-current='page'] {
        color: var(--ink);
        background: var(--paper-2);
    }
    .nav__actions {
        display: flex;
        gap: 8px;
    }
    .nav__btn {
        min-height: 34px;
        padding: 0 14px;
        font-size: 0.8125rem;
    }
    .nav__menu {
        display: none;
    }
    .nav__menu summary {
        list-style: none;
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 4px;
        background: var(--forest);
        color: #f3f6f2;
        cursor: pointer;
    }
    .nav__menu summary::-webkit-details-marker {
        display: none;
    }
    .nav__menu :global(svg) {
        width: 18px;
        height: 18px;
    }
    .nav__menu :global(.i-close),
    .nav__menu[open] :global(.i-open) {
        display: none;
    }
    .nav__menu[open] :global(.i-close) {
        display: block;
    }
    .nav__sheet {
        position: absolute;
        left: 0;
        right: 0;
        top: 64px;
        background: var(--paper);
        border-bottom: 1px solid var(--rule);
        padding: 16px var(--gutter) 24px;
        box-shadow: 0 24px 40px -30px rgb(15 33 26 / 0.4);
    }
    .nav__sheet-search {
        display: flex;
        gap: 8px;
        margin-bottom: 8px;
    }
    .nav__sheet-search input {
        flex: 1;
        min-width: 0;
        height: 42px;
        padding: 0 12px;
        border: 1px solid var(--rule-2);
        border-radius: 4px;
        background: #fff;
        color: var(--ink);
        font: inherit;
    }
    .nav__sheet ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .nav__sheet a {
        display: block;
        padding: 12px 0;
        border-bottom: 1px solid var(--rule);
        color: var(--ink);
        text-decoration: none;
        font-size: 1.35rem;
        font-weight: 300;
        letter-spacing: -0.03em;
    }
    @media (max-width: 1000px) {
        .nav__links {
            display: none;
        }
        .nav__menu {
            display: block;
        }
        .nav__actions {
            margin-left: auto;
        }
    }
    @media (max-width: 480px) {
        .nav__actions .btn--quiet {
            display: none;
        }
    }
</style>
