---
// Newest-year key figures with change against the prior year. Each cell keeps
// its value state (missing / zero / negative / incomparable).
import type { FiscalPeriod, Value } from '../lib/contract/types.ts'
import { compactSek, count, percent, type Display } from '../lib/format.ts'
import { computeMetrics, periodsConsecutive } from '../lib/metrics.ts'
import Val from './Val.astro'

interface Props {
    periods: FiscalPeriod[]
    compact?: boolean
}
const { periods, compact = false } = Astro.props
const [p, prior] = periods
const m = computeMetrics(p, prior)
const mPrior = prior ? computeMetrics(prior, periods[2]) : undefined

const pctDelta = (a: Value, b?: Value): string | null => {
    if (!b || a.status !== 'reported' || b.status !== 'reported' || m.revenueGrowth.status !== 'derived') return null
    const d = a.value / b.value - 1
    return `${d >= 0 ? '+' : '−'}${Math.abs(d * 100).toLocaleString('sv-SE', { maximumFractionDigits: 1, minimumFractionDigits: 1 })} %`
}
const ppDelta = (a: Value, b?: Value): string | null => {
    if (!b || a.status !== 'derived' || b.status !== 'derived' || !periodsConsecutive(p, prior)) return null
    const d = (a.value - b.value) * 100
    return `${d >= 0 ? '+' : '−'}${Math.abs(d).toLocaleString('sv-SE', { maximumFractionDigits: 1, minimumFractionDigits: 1 })} p.e.`
}

const cells: { label: string; d: Display; delta: string | null }[] = [
    { label: 'Nettoomsättning', d: compactSek(p.income.netSales), delta: pctDelta(p.income.netSales, prior?.income.netSales) },
    { label: 'Rörelseresultat', d: compactSek(p.income.operatingProfit), delta: null },
    { label: 'Årets resultat', d: compactSek(p.income.netProfit), delta: null },
    { label: 'Soliditet', d: percent(m.equityRatio), delta: ppDelta(m.equityRatio, mPrior?.equityRatio) },
    { label: 'Kassalikviditet', d: percent(m.quickRatio, 0), delta: null },
    { label: 'Anställda', d: count(p.employees), delta: null },
]
const shown = compact ? cells.filter((c) => c.label !== 'Årets resultat' && c.label !== 'Kassalikviditet') : cells
---

<dl class:list={['kf', { 'kf--compact': compact }]}>
    {
        shown.map((c) => (
            <div class="kf__cell">
                <dt>{c.label}</dt>
                <dd class="kf__v">
                    <Val d={c.d} />
                </dd>
                {c.delta && <dd class="kf__d num">{c.delta} mot året innan</dd>}
            </div>
        ))
    }
</dl>

<style>
    .kf {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0;
        border-top: 1px solid var(--rule);
    }
    .kf__cell {
        padding: 16px 16px 18px 0;
        border-bottom: 1px solid var(--rule);
    }
    .kf__cell:not(:nth-child(3n + 1)) {
        padding-left: 16px;
        border-left: 1px solid var(--rule);
    }
    .kf dt {
        font-size: var(--step--1);
        color: var(--ink-3);
    }
    .kf dd {
        margin: 0;
    }
    .kf__v {
        font-family: var(--serif);
        font-size: 1.85rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-top: 4px;
    }
    .kf__v :global(.val--missing),
    .kf__v :global(.val--incomparable) {
        font-family: var(--sans);
        font-size: 1.05rem;
    }
    .kf__d {
        font-size: var(--step--1);
        color: var(--ink-3);
        margin-top: 2px;
    }
    .kf--compact {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .kf--compact .kf__cell:not(:nth-child(3n + 1)) {
        padding-left: 0;
        border-left: 0;
    }
    .kf--compact .kf__cell:nth-child(2n) {
        padding-left: 16px;
        border-left: 1px solid var(--rule);
    }
    .kf--compact .kf__v {
        font-size: 1.55rem;
    }
    @media (max-width: 640px) {
        .kf {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .kf .kf__cell {
            padding-left: 0;
            border-left: 0;
        }
        .kf .kf__cell:nth-child(2n) {
            padding-left: 14px;
            border-left: 1px solid var(--rule);
        }
        .kf__v {
            font-size: 1.5rem;
        }
    }
</style>
