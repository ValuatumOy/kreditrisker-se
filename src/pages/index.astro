---
import { Picture } from 'astro:assets'
import Base from '../layouts/Base.astro'
import SearchBox from '../components/SearchBox.astro'
import HeroCard from '../components/HeroCard.astro'
import Circuit from '../components/Circuit.astro'
import Val from '../components/Val.astro'
import Icon from '../components/Icon.astro'
import { getDemoSite, getSite } from '../lib/store.ts'
import { SITE, FLAGS } from '../config/site.ts'
import { compactSek, percent } from '../lib/format.ts'
import { FORMULAS, computeMetrics, numeric } from '../lib/metrics.ts'
import { staticReportState } from '../lib/reports/availability.ts'
import { STATE_LABEL } from '../lib/reports/labels.ts'
import type { Value } from '../lib/contract/types.ts'
import { GUIDES } from '../content/guides.ts'
import cityImg from '../assets/photos/stockholm-blue-hour.jpg'
import auroraImg from '../assets/photos/aurora-lake.jpg'
import laplandImg from '../assets/photos/lapland-aerial.jpg'

const site = getSite()
const demo = getDemoSite()
const pick = (prefix: string) => demo.companies.find((c) => c.record.name.startsWith(prefix))!
const samples = [
    { key: 'full', tab: 'Fullständig', note: 'Fem bokslut och alla poster. Nyckeltalen räknas med öppna formler.', company: pick('Exempel Mjukvara') },
    { key: 'sparse', tab: 'Gles', note: 'Förkortat bokslut: bara omsättningen finns. Resten står som saknas, inte som noll.', company: pick('Exempel Fastigheter') },
    { key: 'stale', tab: 'Inaktuell', note: 'Senaste bokslutet avser 2022. Åren därefter visas som luckor.', company: pick('Exempel Metall') },
]
const typing = demo.companies.slice(0, 6).map((c) => c.record.name).concat(['002000-1012'])

// Two small satellite cards next to the hero card (same synthetic company).
const main = pick('Exempel Mjukvara').record
const [p0, p1] = main.periods
const m0 = computeMetrics(p0, p1)
const salesSpark = [...main.periods].reverse().map((p) => numeric(p.income.netSales) ?? 0)
const sparkMax = Math.max(...salesSpark)
const eqPct = (numeric(m0.equityRatio) ?? 0) * 100

const src = { source: 'synthetic', retrievedAt: '2026-09-01' } as const
const states: { label: string; value: Value; fmt: 'sek' | 'pct'; means: string }[] = [
    { label: 'Rapporterat', value: { status: 'reported', value: 30_200_000, source: src }, fmt: 'sek', means: 'Står i årsredovisningen, med källa och räkenskapsår.' },
    { label: 'Noll', value: { status: 'reported', value: 0, source: src }, fmt: 'sek', means: 'Bolaget har redovisat exakt noll.' },
    { label: 'Negativt', value: { status: 'reported', value: -412_000, source: src }, fmt: 'sek', means: 'Förlust eller negativt eget kapital.' },
    { label: 'Saknas', value: { status: 'missing', reason: 'not_in_source' }, fmt: 'sek', means: 'Posten finns inte i källan. Aldrig 0.' },
    { label: 'Ej jämförbar', value: { status: 'incomparable', reason: 'period_length' }, fmt: 'pct', means: 'T.ex. tillväxt efter ett 18-månadersår.' },
]
const reports = (['basic', 'ai'] as const).map((p) => ({ p, s: staticReportState(p, null) }))
const explore = [
    { href: '/branscher/', title: 'Branscher', text: 'Företag efter huvudbransch (SNI).', n: `${site.industries.length}` },
    { href: '/kommuner/', title: 'Kommuner', text: 'Företag efter säteskommun.', n: `${site.municipalities.length}` },
    { href: '/topplistor/', title: 'Topplistor', text: 'Störst, snabbast växande, högst soliditet.', n: `${site.rankings.length}` },
    { href: '/guider/', title: 'Guider', text: 'Läs en årsredovisning, förstå nyckeltalen.', n: `${GUIDES.length}` },
]
const statement =
    'Kreditrisker samlar bokslut, nyckeltal och källor för svenska företag, så att du kan se hur en kund eller leverantör faktiskt ser ut innan du skickar fakturan.'
---

<Base
    title="Bokslut, nyckeltal och kreditrisk för svenska företag"
    description="Sök svenska företag på namn eller organisationsnummer. Bokslut i flera år, nyckeltal med öppna formler och tydliga källor för varje siffra."
    path="/"
    jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.origin + '/', inLanguage: 'sv-SE', potentialAction: { '@type': 'SearchAction', target: `${SITE.origin}/sok/?q={q}`, 'query-input': 'required name=q' } }]}
>
    <!-- ============================================================ HERO -->
    <section class="hero">
        <Circuit />
        <div class="shell hero__inner">
            <p class="hero__badge reveal"><span class="hero__sq" aria-hidden="true">V</span> Byggt av Valuatum</p>
            <h1 class="reveal" style="--d:1">Se siffrorna bakom <span class="tone">varje svenskt företag</span></h1>
            <p class="hero__sub reveal" style="--d:2">Bokslut, nyckeltal och källor på ett ställe. Varje siffra visar räkenskapsår och hur aktuell den är.</p>
            <div class="hero__search reveal" style="--d:3">
                <SearchBox size="hero" id="hero-q" typing={typing} />
            </div>
            <p class="hero__links small reveal" style="--d:4">
                Eller bläddra bland <a href="/branscher/">branscher</a>, <a href="/kommuner/">kommuner</a> och <a href="/topplistor/">topplistor</a>
            </p>
        </div>

        <div class="shell hero__stage">
            <p class="hero__left reveal" style="--d:2">
                <span class="hero__mini" aria-hidden="true"><Icon name="doc" /> Så fungerar det</span>
                Kreditrisker hjälper dig att <b>läsa ett företag på en minut</b>: fem års bokslut, nyckeltal med öppna formler{' '}
                <span class="tone">och luckor som visas som luckor, aldrig som nollor.</span>
            </p>
            <div class="hero__card reveal" style="--d:3">
                <HeroCard samples={samples} />
            </div>
            <div class="hero__sats">
                <div class="sat reveal" style="--d:4">
                    <p class="sat__head"><span>Nettoomsättning</span><span class="sat__tag">Exempel</span></p>
                    <p class="sat__v num" data-count={(numeric(p0.income.netSales) ?? 0) / 1e6} data-decimals="1" data-suffix=" Mkr">{compactSek(p0.income.netSales).text}</p>
                    <svg class="sat__spark" viewBox="0 0 120 40" aria-hidden="true">
                        {salesSpark.map((v, i) => <rect x={i * 25 + 2} y={40 - (v / sparkMax) * 36} width="16" height={(v / sparkMax) * 36} rx="2" class:list={{ last: i === salesSpark.length - 1 }} />)}
                    </svg>
                    <p class="sat__foot">2021–2025 · +9,0 % senaste året</p>
                </div>
                <div class="sat reveal" style="--d:5">
                    <p class="sat__head"><span>Soliditet</span><span class="sat__tag">Exempel</span></p>
                    <p class="sat__v num" data-count={eqPct} data-decimals="1" data-suffix=" %">{percent(m0.equityRatio).text}</p>
                    <div class="sat__meter" aria-hidden="true"><i style={`--w:${eqPct}%`}></i></div>
                    <p class="sat__foot">(Eget kapital + 79,4 % av obesk. res.) / tillgångar</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================ STATEMENT (dark slab) -->
    <section class="slab dark">
        <Circuit tone="dark" class="slab__circuit" />
        <div class="shell slab__inner">
            <p class="chip reveal"><Icon name="info" /> Om tjänsten</p>
            <p class="statement" data-words>{statement}</p>
            <dl class="stats">
                <div class="reveal"><dt>Års bokslut per profil</dt><dd class="num" data-count="5">5</dd></div>
                <div class="reveal" style="--d:1"><dt>Nyckeltal med öppna formler</dt><dd class="num" data-count={Object.keys(FORMULAS).length}>{Object.keys(FORMULAS).length}</dd></div>
                <div class="reveal" style="--d:2"><dt>Gissade värden</dt><dd class="num">0</dd></div>
            </dl>
            <figure class="city" data-clip>
                <Picture src={cityImg} alt="Riddarholmen i Stockholm i blå timmen" formats={['avif', 'webp']} widths={[900, 1600, 2400]} sizes="(max-width: 1320px) 100vw, 1320px" class="city__img" />
                <figcaption class="city__cap glass">
                    <span>Byggt för svenska företag</span>
                    <span class="tone">Organisationsnummer, SNI, kommun och bokslut enligt svensk redovisning (K2/K3).</span>
                </figcaption>
            </figure>
        </div>
    </section>

    <!-- ============================================================ BENTO -->
    <section class="section">
        <div class="shell">
            <div class="section__head">
                <h2 class="reveal">Allt du vill veta <span class="tone">innan du skickar fakturan.</span></h2>
                <p class="reveal" style="--d:1">En profil per organisationsnummer, byggd på inlämnade årsredovisningar och uppdaterad när nya bokslut registreras.</p>
            </div>
            <div class="bento">
                <article class="tile tile--search reveal" data-spotlight>
                    <div class="tile__demo dark demo-search" aria-hidden="true">
                        <div class="ds__bar"><Icon name="search" /><span class="ds__typed">Exempel Bygg</span><span class="ds__caret"></span></div>
                        <ul class="ds__list">
                            <li><b>Exempel Byggnads i Göteborg AB</b><span class="num">002000-1020 · Göteborg</span></li>
                            <li><b>Exempel Snickeri & Bygg Umeå AB</b><span class="num">002000-1178 · Umeå</span></li>
                            <li><b>Exempel Installationsteknik Göteborg AB</b><span class="num">002000-1186 · Göteborg</span></li>
                        </ul>
                    </div>
                    <h3>Sök på namn eller org.nr</h3>
                    <p>Förslag medan du skriver. Tidigare namn hittas också, och ett felskrivet organisationsnummer fångas av kontrollsiffran.</p>
                </article>
                <article class="tile tile--bars reveal" style="--d:1" data-spotlight>
                    <div class="tile__demo dark demo-bars" aria-hidden="true">
                        {[42, 51, 58, 71, 86].map((h, i) => <span style={`--h:${h}%;--i:${i}`}><i class="num">{2021 + i}</i></span>)}
                    </div>
                    <h3>Fem års bokslut</h3>
                    <p>Resultat- och balansräkning år för år, med period och källa i varje kolumn.</p>
                </article>
                <article class="tile tile--gaps reveal" data-spotlight>
                    <div class="tile__demo dark demo-gaps" aria-hidden="true">
                        <div><span>Nettoomsättning</span><b class="num">2,3 Mkr</b></div>
                        <div><span>Eget kapital</span><b class="gap">saknas</b></div>
                        <div><span>Rörelsemarginal</span><b class="gap">ej jämförbar</b></div>
                        <div><span>Årets resultat</span><b class="num neg">−490 tkr</b></div>
                    </div>
                    <h3>Luckor visas som luckor</h3>
                    <p>En uppgift som saknas blir aldrig en nolla, och en negativ siffra syns direkt.</p>
                </article>
                <article class="tile tile--report reveal" style="--d:1" data-spotlight>
                    <div class="tile__demo dark demo-report" aria-hidden="true">
                        <div class="dr__page dr__page--3"></div>
                        <div class="dr__page dr__page--2"></div>
                        <div class="dr__page dr__page--1">
                            <i></i><i></i><i class="short"></i>
                            <svg viewBox="0 0 120 40"><path d="M0,34 C20,30 30,26 45,24 C60,22 70,14 85,12 C100,10 110,6 120,4"></path></svg>
                            <i></i><i class="short"></i>
                        </div>
                        <div class="dr__scan"></div>
                    </div>
                    <h3>Basrapport och AI-rapport</h3>
                    <p>Två rapporter från varje profil när de är klara för svenska företag. <a href="/rapporter/">Läs om rapporterna</a>.</p>
                </article>
            </div>
        </div>
    </section>

    <!-- ============================================================ STATES -->
    <section class="section states">
        <div class="shell">
            <div class="section__head">
                <h2 class="reveal">Varje värde har ett tillstånd, <span class="tone">inte bara en siffra.</span></h2>
                <p class="reveal" style="--d:1">Små bolag lämnar ofta förkortade bokslut, och alla räkenskapsår är inte tolv månader. Därför skiljer vi på fem sorters värden.</p>
            </div>
            <ol class="states__row">
                {
                    states.map((s, i) => (
                        <li class="states__card reveal" style={`--d:${i}`}>
                            <span class="states__label">{s.label}</span>
                            <span class="states__v">
                                <Val d={s.fmt === 'sek' ? compactSek(s.value) : percent(s.value)} />
                            </span>
                            <span class="states__means">{s.means}</span>
                        </li>
                    ))
                }
            </ol>
            <p class="states__foot small muted reveal">
                Profiler med för få uppgifter eller bokslut äldre än 31 månader visas men indexeras inte. Tröskeln står på <a href="/metod/#index">metodsidan</a>.
            </p>
        </div>
    </section>

    <!-- ============================================================ SOURCES -->
    <section class="section sources">
        <div class="shell sources__grid">
            <div class="sources__photo" data-clip>
                <Picture src={laplandImg} alt="Snötäckt fjällandskap i Lappland i kvällsljus" formats={['avif', 'webp']} widths={[700, 1200]} sizes="(max-width: 900px) 100vw, 50vw" class="sources__img" />
                <div class="sources__chip">
                    <b>Bolagsverket</b>
                    <span>Årsredovisning 2025 · registrerad 15 maj 2026</span>
                </div>
            </div>
            <div class="sources__copy">
                <p class="chip reveal"><Icon name="doc" /> Källor</p>
                <h2 class="reveal">Källan först. <span class="tone">Alltid.</span></h2>
                <p class="lede reveal" style="--d:1">Under varje tabell står varifrån siffrorna kommer, vilket räkenskapsår de gäller och när vi hämtade dem.</p>
                <ul class="sources__list">
                    <li class="reveal" style="--d:2"><b>Bolagsverket</b><span>Registeruppgifter och digitalt inlämnade årsredovisningar.</span></li>
                    <li class="reveal" style="--d:3"><b>SCB</b><span>Bransch (SNI) och kommun, där det kompletterar.</span></li>
                    <li class="reveal" style="--d:4"><b>Valuatum</b><span>Nyckeltal med publicerade formler. Kreditbetyg först när modellen är validerad för Sverige.</span></li>
                </ul>
                <p class="small muted reveal">Källorna kräver avtal om datalicens innan publicering. <a href="/kallor/">Om datakällorna</a></p>
            </div>
        </div>
    </section>

    <!-- ============================================================ REPORTS (aurora) -->
    <section class="reports dark">
        <Picture src={auroraImg} alt="" formats={['avif', 'webp']} widths={[1000, 1800, 2600]} sizes="100vw" class="reports__img" aria-hidden="true" />
        <div class="reports__shade" aria-hidden="true"></div>
        <div class="shell reports__inner">
            <div class="section__head">
                <h2 class="reveal">Två rapporter. <span class="tone">När de är redo.</span></h2>
                <p class="reveal" style="--d:1">Rapporterna om svenska företag är under utveckling. Vi visar inga priser och tar inga beställningar förrän allt är granskat.</p>
            </div>
            <div class="reports__grid">
                {
                    reports.map(({ p, s }, i) => (
                        <article class="rcard reveal" style={`--d:${i}`} data-spotlight>
                            <div class="rcard__top">
                                <h3>{p === 'basic' ? 'Basrapport' : 'AI-rapport'}</h3>
                                <span class="tag tag--warn">{STATE_LABEL[s.kind]}</span>
                            </div>
                            <p class="rcard__lede">
                                {p === 'basic' ? 'Bokslut, nyckeltal och branschjämförelse samlade i en PDF.' : 'Basrapporten plus en skriven analys och en genomgång av offentliga källor.'}
                            </p>
                            <ul class="rcard__list">
                                {(p === 'basic'
                                    ? ['Registeruppgifter och fem års bokslut', 'Nyckeltal med förklaringar', 'Jämförelse med branschen', 'Kreditbetyg när modellen validerats']
                                    : ['Allt i basrapporten', 'Analys av lönsamhet, soliditet och likviditet', 'Offentliga källor med länkar', 'Slutsatser och begränsningar']
                                ).map((x) => (
                                    <li>
                                        <Icon name="check" /> {x}
                                    </li>
                                ))}
                            </ul>
                            <div class="rcard__foot">
                                <span class="rcard__price">Pris: inte fastställt</span>
                                <a class="btn" href={p === 'basic' ? '/rapporter/bas/' : '/rapporter/ai/'}>
                                    Läs mer
                                </a>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ============================================================ EXPLORE -->
    <section class="section explore">
        <div class="shell">
            <div class="section__head">
                <h2 class="reveal">Hitta företag <span class="tone">på fler sätt.</span></h2>
                <p class="reveal" style="--d:1">Bläddra efter bransch och ort, jämför i topplistor eller läs på om nyckeltal.</p>
            </div>
            <ul class="explore__list">
                {
                    explore.map((e, i) => (
                        <li class="reveal" style={`--d:${i}`}>
                            <a href={e.href}>
                                <span class="explore__n num">{e.n}</span>
                                <span class="explore__t">{e.title}</span>
                                <span class="explore__x">{e.text}</span>
                                <span class="explore__go">
                                    <Icon name="arrow" />
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- ============================================================ CTA -->
    <section class="cta dark">
        <Circuit tone="dark" />
        <div class="shell cta__inner">
            <h2 class="reveal">Börja med ett <span class="tone">organisations&shy;nummer.</span></h2>
            <div class="cta__search reveal" style="--d:1"><SearchBox id="cta-q" /></div>
            {!FLAGS.checkout && <p class="small reveal" style="--d:2">Profilerna är gratis. Rapporter säljs inte ännu.</p>}
        </div>
    </section>
</Base>

<style>
    /* ---------------- hero */
    .hero {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        padding-top: clamp(40px, 7vw, 88px);
    }
    .hero :global(.circuit) {
        z-index: -1;
        mask-image: radial-gradient(ellipse 75% 70% at 50% 45%, transparent 22%, #000 62%);
    }
    .hero__inner {
        display: grid;
        justify-items: center;
        text-align: center;
    }
    .hero__badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--ink-2);
    }
    .hero__sq {
        display: grid;
        place-items: center;
        width: 18px;
        height: 18px;
        border-radius: 3px;
        background: var(--forest);
        color: #f3f6f2;
        font-size: 0.7rem;
        font-weight: 600;
    }
    .hero h1 {
        margin-top: 22px;
        font-size: clamp(2.4rem, 1.2rem + 5.2vw, 5.6rem);
        line-height: 0.98;
        letter-spacing: -0.055em;
        font-weight: 300;
        max-width: 17ch;
    }
    .hero__sub {
        margin-top: 22px;
        max-width: 40ch;
        color: var(--ink-3);
        font-size: 1.02rem;
    }
    .hero__search {
        position: relative;
        z-index: 10;
        margin-top: 30px;
        width: min(560px, 100%);
    }
    .hero__links {
        margin-top: 14px;
        color: var(--ink-3);
    }
    .hero__stage {
        position: relative;
        display: grid;
        grid-template-columns: 1fr minmax(0, 520px) 1fr;
        gap: 28px;
        align-items: end;
        margin-top: clamp(48px, 7vw, 88px);
    }
    .hero__left {
        position: relative;
        align-self: end;
        max-width: 30ch;
        padding-bottom: 48px;
        font-size: 1.15rem;
        line-height: 1.3;
        letter-spacing: -0.02em;
        color: var(--ink);
    }
    .hero__left::before {
        content: '';
        position: absolute;
        inset: -64px -72px 0;
        z-index: -1;
        background: radial-gradient(closest-side, var(--paper) 78%, transparent);
    }
    .hero__left b {
        font-weight: 500;
    }
    .hero__mini {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 12px;
        font-size: 0.72rem;
        color: var(--ink-3);
        letter-spacing: 0;
    }
    .hero__mini :global(svg) {
        width: 13px;
        height: 13px;
    }
    .hero__card {
        position: relative;
        z-index: 2;
        margin-bottom: -40px;
    }
    .hero__sats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        padding-bottom: 48px;
    }
    .sat {
        padding: 14px;
        border-radius: 10px;
        background: var(--night-2);
        color: var(--ice);
        box-shadow: 0 24px 50px -30px rgb(15 33 26 / 0.7);
    }
    .sat__head {
        display: flex;
        justify-content: space-between;
        gap: 6px;
        font-size: 0.7rem;
        color: var(--ice-3);
    }
    .sat__tag {
        padding: 0 5px;
        border-radius: 2px;
        border: 1px solid rgb(255 255 255 / 0.16);
        font-size: 0.62rem;
        color: var(--gold);
    }
    .sat__v {
        margin-top: 6px;
        font-size: 1.35rem;
        font-weight: 400;
        letter-spacing: -0.03em;
    }
    .sat__spark {
        width: 100%;
        height: 34px;
        margin-top: 8px;
    }
    .sat__spark rect {
        fill: rgb(159 212 176 / 0.35);
        transform-box: fill-box;
        transform-origin: bottom;
    }
    .sat__spark rect.last {
        fill: var(--glow);
    }
    .sat__meter {
        height: 6px;
        margin-top: 18px;
        border-radius: 2px;
        background: rgb(255 255 255 / 0.1);
        overflow: hidden;
    }
    .sat__meter i {
        display: block;
        width: var(--w);
        height: 100%;
        background: var(--glow);
        transform-origin: left;
    }
    .sat__foot {
        margin-top: 10px;
        font-size: 0.66rem;
        color: var(--ice-3);
        line-height: 1.35;
    }
    @media (prefers-reduced-motion: no-preference) {
        .sat.in .sat__spark rect {
            animation: grow 1s var(--ease-out) both;
        }
        .sat.in .sat__spark rect:nth-child(2) {
            animation-delay: 80ms;
        }
        .sat.in .sat__spark rect:nth-child(3) {
            animation-delay: 160ms;
        }
        .sat.in .sat__spark rect:nth-child(4) {
            animation-delay: 240ms;
        }
        .sat.in .sat__spark rect:nth-child(5) {
            animation-delay: 320ms;
        }
        .sat.in .sat__meter i {
            animation: fill 1.4s var(--ease-out) 200ms both;
        }
    }
    @keyframes grow {
        from {
            transform: scaleY(0);
        }
