---
import { Picture } from 'astro:assets'
import Base from '../layouts/Base.astro'
import SearchBox from '../components/SearchBox.astro'
import HeroCard from '../components/HeroCard.astro'
import Val from '../components/Val.astro'
import Icon from '../components/Icon.astro'
import { getDemoSite, getSite } from '../lib/store.ts'
import { SITE, FLAGS } from '../config/site.ts'
import { compactSek, percent } from '../lib/format.ts'
import { FORMULAS } from '../lib/metrics.ts'
import { staticReportState } from '../lib/reports/availability.ts'
import { STATE_LABEL } from '../lib/reports/labels.ts'
import type { Value } from '../lib/contract/types.ts'
import { GUIDES } from '../content/guides.ts'
import heroImg from '../assets/photos/stockholm-blue-hour.jpg'
import auroraImg from '../assets/photos/aurora-lake.jpg'
import laplandImg from '../assets/photos/lapland-aerial.jpg'

const site = getSite()
const demo = getDemoSite()
const pick = (prefix: string) => demo.companies.find((c) => c.record.name.startsWith(prefix))!
const samples = [
    { key: 'full', tab: 'Fullständig', note: 'Fem bokslut och alla poster. Nyckeltalen räknas med öppna formler.', company: pick('Exempel Mjukvara') },
    { key: 'sparse', tab: 'Gles', note: 'Förkortat bokslut: bara omsättningen finns. Resten står som saknas, inte som noll.', company: pick('Exempel Fastigheter') },
    { key: 'stale', tab: 'Inaktuell', note: 'Senaste bokslutet avser 2022. Åren därefter visas som luckor.', company: pick('Exempel Metall') },
]
const typing = demo.companies.slice(0, 6).map((c) => c.record.name).concat(['002000-1012'])

// Skyline of the hero photo traced as a chart line (image pixel coordinates, 2800 x 1867).
const sky = [
    [0, 1197], [70, 1155], [175, 1155], [301, 1162], [319, 1043], [336, 1162], [420, 1162], [616, 1141], [826, 1141], [840, 1204],
    [1050, 1190], [1071, 1008], [1092, 833], [1113, 1008], [1134, 1190], [1260, 1204], [1400, 1232], [1736, 1232], [1820, 1225],
    [2072, 1204], [2142, 1148], [2163, 1190], [2366, 1176], [2380, 1064], [2401, 1176], [2590, 1176], [2800, 1204],
]
const skyPath = sky.map(([x, y], i) => `${i ? 'L' : 'M'}${x},${y}`).join(' ')

const src = { source: 'synthetic', retrievedAt: '2026-09-01' } as const
const states: { label: string; value: Value; fmt: 'sek' | 'pct'; means: string }[] = [
    { label: 'Rapporterat', value: { status: 'reported', value: 30_200_000, source: src }, fmt: 'sek', means: 'Står i årsredovisningen, med källa och räkenskapsår.' },
    { label: 'Noll', value: { status: 'reported', value: 0, source: src }, fmt: 'sek', means: 'Bolaget har redovisat exakt noll.' },
    { label: 'Negativt', value: { status: 'reported', value: -412_000, source: src }, fmt: 'sek', means: 'Förlust eller negativt eget kapital.' },
    { label: 'Saknas', value: { status: 'missing', reason: 'not_in_source' }, fmt: 'sek', means: 'Posten finns inte i källan. Aldrig 0.' },
    { label: 'Ej jämförbar', value: { status: 'incomparable', reason: 'period_length' }, fmt: 'pct', means: 'T.ex. tillväxt efter ett 18-månadersår.' },
]
const industries = [...new Set(demo.companies.flatMap((c) => c.record.sni.map((s) => s.label)))]
const reports = (['basic', 'ai'] as const).map((p) => ({ p, s: staticReportState(p, null) }))
const explore = [
    { href: '/branscher/', title: 'Branscher', text: 'Företag efter huvudbransch (SNI).', n: `${site.industries.length}` },
    { href: '/kommuner/', title: 'Kommuner', text: 'Företag efter säteskommun.', n: `${site.municipalities.length}` },
    { href: '/topplistor/', title: 'Topplistor', text: 'Störst, snabbast växande, högst soliditet.', n: `${site.rankings.length}` },
    { href: '/guider/', title: 'Guider', text: 'Läs en årsredovisning, förstå nyckeltalen.', n: `${GUIDES.length}` },
]
---

<Base
    title="Bokslut, nyckeltal och kreditrisk för svenska företag"
    description="Sök svenska företag på namn eller organisationsnummer. Bokslut i flera år, nyckeltal med öppna formler och tydliga källor för varje siffra."
    path="/"
    jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.origin + '/', inLanguage: 'sv-SE', potentialAction: { '@type': 'SearchAction', target: `${SITE.origin}/sok/?q={q}`, 'query-input': 'required name=q' } }]}
>
    <!-- ============================================================ HERO -->
    <section class="hero dark grain">
        <div class="hero__media" aria-hidden="true">
            <Picture src={heroImg} alt="" formats={['avif', 'webp']} widths={[900, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="hero__img" />
            <svg class="hero__sky" viewBox="0 0 2800 1867" preserveAspectRatio="xMidYMid slice">
                <defs>
                    <linearGradient id="skyline-stroke" x1="0" x2="1" y1="0" y2="0">
                        <stop offset="0" stop-color="#f4bf72" stop-opacity="0"></stop>
                        <stop offset="0.25" stop-color="#f4bf72" stop-opacity="0.9"></stop>
                        <stop offset="0.8" stop-color="#ffd9a0" stop-opacity="1"></stop>
                        <stop offset="1" stop-color="#f4bf72" stop-opacity="0.2"></stop>
                    </linearGradient>
                </defs>
                {[820, 960, 1100].map((y) => <line x1="0" x2="2800" y1={y} y2={y} class="hero__gridline" />)}
                <path d={skyPath} class="hero__skyline" pathLength="1" id="skyline"></path>
                <circle r="9" class="hero__runner">
                    <animateMotion dur="14s" repeatCount="indefinite" rotate="auto">
                        <mpath href="#skyline"></mpath>
                    </animateMotion>
                </circle>
                {[[1092, 833], [319, 1043], [2380, 1064]].map(([x, y]) => <circle cx={x} cy={y} r="7" class="hero__peak" />)}
            </svg>
            <div class="hero__shade"></div>
        </div>

        <div class="shell hero__grid">
            <div class="hero__copy">
                <p class="hero__pill reveal"><span class="hero__pulse" aria-hidden="true"></span> Under uppbyggnad för svenska företag</p>
                <h1 class="reveal" style="--d:1">Se siffrorna bakom varje <em>svenskt företag.</em></h1>
                <p class="lede reveal" style="--d:2">Bokslut, nyckeltal och källor på ett ställe. Varje siffra visar räkenskapsår och hur aktuell den är, och det som saknas står som saknas.</p>
                <div class="hero__search reveal" style="--d:3">
                    <SearchBox size="hero" id="hero-q" typing={typing} />
                </div>
                <ul class="hero__facts reveal" style="--d:4">
                    <li><b class="num">5</b> års bokslut per profil</li>
                    <li><b class="num">{Object.keys(FORMULAS).length}</b> nyckeltal med öppna formler</li>
                    <li><b class="num">0</b> gissade värden</li>
                </ul>
            </div>
            <div class="hero__card reveal" style="--d:3">
                <HeroCard samples={samples} />
            </div>
        </div>
    </section>

    <!-- ============================================================ MARQUEE -->
    <section class="marquee dark" aria-label="Exempel på branscher">
        <div class="marquee__track">
            {[0, 1].map((k) => (
                <ul aria-hidden={k === 1 ? 'true' : undefined}>
                    {industries.map((i) => <li>{i}</li>)}
                </ul>
            ))}
        </div>
    </section>

    <!-- ============================================================ BENTO -->
    <section class="section dark bento-wrap">
        <div class="shell">
            <div class="section__head">
                <h2 class="reveal">Allt du vill veta innan du skickar fakturan.</h2>
                <p class="reveal" style="--d:1">En profil per organisationsnummer, byggd på inlämnade årsredovisningar och uppdaterad när nya bokslut registreras.</p>
            </div>
            <div class="bento">
                <article class="tile tile--search reveal" data-spotlight>
                    <div class="tile__demo demo-search" aria-hidden="true">
                        <div class="ds__bar"><Icon name="search" /><span class="ds__typed">Exempel Bygg</span><span class="ds__caret"></span></div>
                        <ul class="ds__list">
                            <li><b>Exempel Byggnads i Göteborg AB</b><span class="num">002000-1020 · Göteborg</span></li>
                            <li><b>Exempel Snickeri & Bygg Umeå AB</b><span class="num">002000-1178 · Umeå</span></li>
                            <li><b>Exempel Installationsteknik Göteborg AB</b><span class="num">002000-1186 · Göteborg</span></li>
                        </ul>
                    </div>
                    <h3>Sök på namn eller org.nr</h3>
                    <p>Förslag medan du skriver. Tidigare namn hittas också, och ett felskrivet organisationsnummer fångas av kontrollsiffran.</p>
                </article>
                <article class="tile tile--bars reveal" style="--d:1" data-spotlight>
                    <div class="tile__demo demo-bars" aria-hidden="true">
                        {[42, 51, 58, 71, 86].map((h, i) => <span style={`--h:${h}%;--i:${i}`}><i class="num">{2021 + i}</i></span>)}
                    </div>
                    <h3>Fem års bokslut</h3>
                    <p>Resultat- och balansräkning år för år, med period och källa i varje kolumn.</p>
                </article>
                <article class="tile tile--gaps reveal" data-spotlight>
                    <div class="tile__demo demo-gaps" aria-hidden="true">
                        <div><span>Nettoomsättning</span><b class="num">2,3 Mkr</b></div>
                        <div><span>Eget kapital</span><b class="gap">saknas</b></div>
                        <div><span>Rörelsemarginal</span><b class="gap">ej jämförbar</b></div>
                        <div><span>Årets resultat</span><b class="num neg">−490 tkr</b></div>
                    </div>
                    <h3>Luckor visas som luckor</h3>
                    <p>En uppgift som saknas blir aldrig en nolla, och en negativ siffra syns direkt.</p>
                </article>
                <article class="tile tile--report reveal" style="--d:1" data-spotlight>
                    <div class="tile__demo demo-report" aria-hidden="true">
                        <div class="dr__page dr__page--3"></div>
                        <div class="dr__page dr__page--2"></div>
                        <div class="dr__page dr__page--1">
                            <i></i><i></i><i class="short"></i>
                            <svg viewBox="0 0 120 40"><path d="M0,34 C20,30 30,26 45,24 C60,22 70,14 85,12 C100,10 110,6 120,4" /></svg>
                            <i></i><i class="short"></i>
                        </div>
                        <div class="dr__scan"></div>
                    </div>
                    <h3>Basrapport och AI-rapport</h3>
                    <p>Två rapporter från varje profil när de är klara för svenska företag. <a href="/rapporter/">Läs om rapporterna</a>.</p>
                </article>
            </div>
        </div>
    </section>

    <!-- ============================================================ STATES (day) -->
    <section class="section states">
        <div class="shell">
            <div class="section__head">
                <h2 class="reveal">Varje värde har ett tillstånd, inte bara en siffra.</h2>
                <p class="reveal" style="--d:1">Små bolag lämnar ofta förkortade bokslut, och alla räkenskapsår är inte tolv månader. Därför skiljer vi på fem sorters värden.</p>
            </div>
            <ol class="states__row">
                {
                    states.map((s, i) => (
                        <li class="states__card reveal" style={`--d:${i}`}>
                            <span class="states__label">{s.label}</span>
                            <span class="states__v">
                                <Val d={s.fmt === 'sek' ? compactSek(s.value) : percent(s.value)} />
                            </span>
                            <span class="states__means">{s.means}</span>
                        </li>
                    ))
                }
            </ol>
            <p class="states__foot small muted reveal">
                Profiler med för få uppgifter eller bokslut äldre än 31 månader visas men indexeras inte. Tröskeln står på <a href="/metod/#index">metodsidan</a>.
            </p>
        </div>
    </section>

    <!-- ============================================================ SOURCES (day, photo) -->
    <section class="section sources">
        <div class="shell sources__grid">
            <div class="sources__photo reveal">
                <Picture src={laplandImg} alt="Snötäckt fjällandskap i Lappland i kvällsljus" formats={['avif', 'webp']} widths={[700, 1200]} sizes="(max-width: 900px) 100vw, 50vw" class="sources__img" />
                <div class="sources__chip glass dark">
                    <span class="num">Bolagsverket</span>
                    <span>Årsredovisning 2025 · registrerad 15 maj 2026</span>
                </div>
            </div>
            <div class="sources__copy">
                <h2 class="reveal">Källan först. Alltid.</h2>
                <p class="lede reveal" style="--d:1">Under varje tabell står varifrån siffrorna kommer, vilket räkenskapsår de gäller och när vi hämtade dem.</p>
                <ol class="sources__list">
                    <li class="reveal" style="--d:2"><span class="sources__n num">01</span><div><b>Bolagsverket</b><span>Registeruppgifter och digitalt inlämnade årsredovisningar.</span></div></li>
                    <li class="reveal" style="--d:3"><span class="sources__n num">02</span><div><b>SCB</b><span>Bransch (SNI) och kommun, där det kompletterar.</span></div></li>
                    <li class="reveal" style="--d:4"><span class="sources__n num">03</span><div><b>Valuatum</b><span>Nyckeltal med publicerade formler. Kreditbetyg först när modellen är validerad för Sverige.</span></div></li>
                </ol>
                <p class="small muted reveal">Källorna kräver avtal om datalicens innan publicering. <a href="/kallor/">Om datakällorna</a></p>
            </div>
        </div>
    </section>

    <!-- ============================================================ REPORTS (aurora) -->
    <section class="reports dark grain">
        <Picture src={auroraImg} alt="" formats={['avif', 'webp']} widths={[1000, 1800, 2600]} sizes="100vw" class="reports__img" aria-hidden="true" />
        <div class="reports__shade" aria-hidden="true"></div>
        <div class="shell reports__inner">
            <div class="section__head">
                <h2 class="reveal">Två rapporter. När de är redo.</h2>
                <p class="reveal" style="--d:1">Rapporterna om svenska företag är under utveckling. Vi visar inga priser och tar inga beställningar förrän allt är granskat.</p>
            </div>
            <div class="reports__grid">
                {
                    reports.map(({ p, s }, i) => (
                        <article class="rcard glass reveal" style={`--d:${i}`} data-spotlight>
                            <div class="rcard__top">
                                <h3>{p === 'basic' ? 'Basrapport' : 'AI-rapport'}</h3>
                                <span class="tag tag--warn">{STATE_LABEL[s.kind]}</span>
                            </div>
                            <p class="rcard__lede">
                                {p === 'basic' ? 'Bokslut, nyckeltal och branschjämförelse samlade i en PDF.' : 'Basrapporten plus en skriven analys och en genomgång av offentliga källor.'}
                            </p>
                            <ul class="rcard__list">
                                {(p === 'basic'
                                    ? ['Registeruppgifter och fem års bokslut', 'Nyckeltal med förklaringar', 'Jämförelse med branschen', 'Kreditbetyg när modellen validerats']
                                    : ['Allt i basrapporten', 'Analys av lönsamhet, soliditet och likviditet', 'Offentliga källor med länkar', 'Slutsatser och begränsningar']
                                ).map((x) => (
                                    <li>
                                        <Icon name="check" /> {x}
                                    </li>
                                ))}
                            </ul>
                            <div class="rcard__foot">
                                <span class="rcard__price">Pris: inte fastställt</span>
                                <a class="btn btn--quiet" href={p === 'basic' ? '/rapporter/bas/' : '/rapporter/ai/'}>
                                    Läs mer <Icon name="arrow" />
                                </a>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ============================================================ EXPLORE (day) -->
    <section class="section explore">
        <div class="shell">
            <div class="section__head">
                <h2 class="reveal">Hitta företag på fler sätt.</h2>
                <p class="reveal" style="--d:1">Bläddra efter bransch och ort, jämför i topplistor eller läs på om nyckeltal.</p>
            </div>
            <ul class="explore__list">
                {
                    explore.map((e, i) => (
                        <li class="reveal" style={`--d:${i}`}>
                            <a href={e.href}>
                                <span class="explore__n num">{e.n}</span>
                                <span class="explore__t">{e.title}</span>
                                <span class="explore__x">{e.text}</span>
                                <span class="explore__go">
                                    <Icon name="arrow" />
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <!-- ============================================================ CTA -->
    <section class="cta dark grain">
        <div class="cta__glow" aria-hidden="true"></div>
        <div class="shell cta__inner">
            <h2 class="reveal">Börja med ett organisationsnummer.</h2>
            <div class="cta__search reveal" style="--d:1"><SearchBox id="cta-q" /></div>
            {!FLAGS.checkout && <p class="small reveal" style="--d:2">Profilerna är gratis. Rapporter säljs inte ännu.</p>}
        </div>
    </section>
</Base>

<style>
    /* ---------------- hero */
    .hero {
        position: relative;
        min-height: max(760px, min(100svh, 1000px));
        display: flex;
        align-items: center;
        overflow: hidden;
        isolation: isolate;
    }
    .hero__media {
        position: absolute;
        inset: 0;
        z-index: -1;
    }
    .hero__media :global(.hero__img),
    .hero__media :global(picture) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }
    .hero__media :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 50%;
        transform: scale(1.04);
        animation: hero-drift 30s ease-in-out infinite alternate;
    }
    @keyframes hero-drift {
        to {
            transform: scale(1.1) translate(-1%, -0.5%);
        }
    }
    .hero__sky {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transform: scale(1.04);
        animation: hero-drift 30s ease-in-out infinite alternate;
    }
    .hero__gridline {
        stroke: rgb(238 243 250 / 0.12);
        stroke-width: 1.6;
        stroke-dasharray: 6 14;
    }
    .hero__skyline {
        fill: none;
        stroke: url(#skyline-stroke);
        stroke-width: 4;
        stroke-linejoin: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: sky-draw 3.4s var(--ease-out) 0.5s forwards;
    }
    @keyframes sky-draw {
        to {
            stroke-dashoffset: 0;
        }
    }
    .hero__runner {
        fill: #ffe2b0;
    }
    .hero__peak {
        fill: #f4bf72;
        opacity: 0;
        animation: peak 3.2s ease-in-out 3s infinite;
    }
    @keyframes peak {
        0%,
        100% {
            opacity: 0.2;
            r: 6;
        }
        50% {
            opacity: 0.95;
            r: 11;
        }
    }
    .hero__shade {
        position: absolute;
        inset: 0;
        background:
            linear-gradient(180deg, rgb(5 10 21 / 0.85) 0%, rgb(5 10 21 / 0.35) 30%, rgb(5 10 21 / 0) 55%, rgb(5 10 21 / 0.55) 82%, var(--night) 100%),
            linear-gradient(90deg, rgb(5 10 21 / 0.82) 0%, rgb(5 10 21 / 0.45) 40%, rgb(5 10 21 / 0) 62%);
    }
    .hero__grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--col-gap);
        row-gap: 48px;
        align-items: center;
        padding-top: 120px;
        padding-bottom: 72px;
    }
    .hero__copy {
        grid-column: 1 / span 6;
    }
    .hero__pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 6px 14px 6px 10px;
        border-radius: 999px;
        border: 1px solid rgb(255 255 255 / 0.16);
        background: rgb(255 255 255 / 0.06);
        backdrop-filter: blur(10px);
        font-size: 0.82rem;
        color: var(--ice-2);
    }
    .hero__pulse {
        position: relative;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--gold);
    }
    .hero__pulse::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: var(--gold);
        animation: ping 2s ease-out infinite;
    }
    @keyframes ping {
        to {
            transform: scale(3);
            opacity: 0;
        }
    }
    .hero h1 {
        margin-top: 22px;
        font-size: clamp(3rem, 1.4rem + 5vw, 5.4rem);
        line-height: 0.98;
        letter-spacing: -0.045em;
        font-weight: 300;
        max-width: 12ch;
        color: #fff;
    }
    .hero h1 em {
        font-style: normal;
        color: var(--gold);
    }
    .hero .lede {
        margin-top: 24px;
        color: var(--ice-2);
        max-width: 44ch;
    }
    .hero__search {
        margin-top: 36px;
        max-width: 580px;
    }
    .hero__facts {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 28px;
        list-style: none;
        margin: 26px 0 0;
        padding: 0;
        font-size: 0.86rem;
        color: var(--ice-3);
    }
    .hero__facts b {
        color: var(--ice);
        font-weight: 500;
        margin-right: 4px;
    }
    .hero__card {
        grid-column: 8 / span 5;
        align-self: end;
        margin-bottom: -8px;
    }
    @media (max-width: 1080px) {
        .hero__shade {
            background: linear-gradient(180deg, rgb(5 10 21 / 0.8) 0%, rgb(5 10 21 / 0.55) 40%, rgb(5 10 21 / 0.75) 70%, var(--night) 100%);
        }
        .hero__copy,
        .hero__card {
            grid-column: 1 / -1;
        }
        .hero__card {
            max-width: 560px;
        }
        .hero {
            align-items: flex-start;
        }
    }
    @media (max-width: 560px) {
        .hero__grid {
            padding-top: 104px;
        }
        .hero__facts {
            font-size: 0.8rem;
            gap: 6px 16px;
        }
    }

    /* ---------------- marquee */
    .marquee {
        overflow: hidden;
        border-block: 1px solid rgb(255 255 255 / 0.07);
        padding-block: 18px;
    }
    .marquee__track {
        display: flex;
        width: max-content;
        animation: marquee 50s linear infinite;
        mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }
    .marquee ul {
        display: flex;
        gap: 48px;
        list-style: none;
        margin: 0;
        padding: 0 24px;
    }
    .marquee li {
        font-family: var(--serif);
        font-size: 1.15rem;
        font-weight: 350;
        color: var(--ice-3);
        white-space: nowrap;
    }
    .marquee li::before {
        content: '';
        display: inline-block;
        width: 5px;
        height: 5px;
