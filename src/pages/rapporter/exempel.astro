---
import Page from '../../layouts/Page.astro'
import Icon from '../../components/Icon.astro'
import { FLAGS } from '../../config/site.ts'
---

<Page
    title="Exempelrapporter"
    description="Läs en kreditrapport och ett utdrag ur en AI-rapport baserade på svenska företags bokslut."
    path="/rapporter/exempel/"
    lede="Se hur Valuatums rapporter ser ut i PDF-format. Båda exemplen bygger på svenska företags bokslut."
    crumbs={[{ href: '/rapporter/', label: 'Rapporter' }, { label: 'Exempel' }]}
>
    <div class="examples">
        <article class="example" id="basrapport" aria-labelledby="bas-h">
            <h2 id="bas-h">Kreditrapport</h2>
            <p>Älvsjö Konditori &amp; Bageri Aktiebolag</p>
            <p class="small muted">19 sidor · Rapportdatum 30 oktober 2026</p>
            <p>Kreditbetyg, fem års bokslut, nyckeltal och branschjämförelse.</p>
            <a class="btn" href="/rapporter/exempel/kreditrapport-alvsjo-konditori.pdf">
                <Icon name="doc" /> Läs kreditrapporten (PDF)
            </a>
        </article>

        <article class="example" id="ai-rapport" aria-labelledby="ai-h">
            <h2 id="ai-h">AI-rapport</h2>
            <p>KJS Sport AB</p>
            <p class="small muted">13 sidor · Rapportdatum 6 november 2026 · Utdrag</p>
            <p>Finansiell analys, riskbedömning och bokslut. Personuppgifter och avsnittet om bakgrundskontroller har utelämnats i utdraget.{FLAGS.reports.ai !== 'live' && ' AI-rapporten kan ännu inte beställas.'}</p>
            <a class="btn btn--quiet" href="/rapporter/exempel/ai-rapport-kjs-sport-utdrag.pdf">
                <Icon name="doc" /> Läs utdraget ur AI-rapporten (PDF)
            </a>
        </article>
    </div>
</Page>

<style>
    .examples {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
        gap: 24px;
    }

    .example {
        display: grid;
        grid-template-rows: auto auto auto 1fr auto;
        justify-items: start;
        gap: 12px;
        padding: clamp(20px, 4vw, 36px);
        border: 1px solid var(--rule);
        background: var(--sheet);
        scroll-margin-top: 90px;
    }

    .example h2 {
        font-size: var(--step-2);
    }

    .example p {
        margin: 0;
    }
</style>
